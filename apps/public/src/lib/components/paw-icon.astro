---
// The one drawn mark on the public side. Inline rather than a sprite or an icon package: it is a
// single shape, it has to take `currentColor` to carry meaning in the fee breakdown on SCR-01,
// and the public app deliberately has no icon library (DEV-06 §5).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class={className}>
  <ellipse cx="5.6" cy="10" rx="2.5" ry="3.3" transform="rotate(-22 5.6 10)"></ellipse>
  <ellipse cx="10" cy="6.6" rx="2.4" ry="3.5" transform="rotate(-8 10 6.6)"></ellipse>
  <ellipse cx="15" cy="6.6" rx="2.4" ry="3.5" transform="rotate(8 15 6.6)"></ellipse>
  <ellipse cx="19.4" cy="10" rx="2.5" ry="3.3" transform="rotate(22 19.4 10)"></ellipse>
  <path d="M12.5 12.4c3.5 0 6.4 2.4 6.4 5.2 0 2.2-1.8 3.5-3.9 3.5-1 0-1.7-.3-2.5-.3s-1.5.3-2.5.3c-2.1 0-3.9-1.3-3.9-3.5 0-2.8 2.9-5.2 6.4-5.2Z"></path>
</svg>

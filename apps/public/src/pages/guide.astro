---
// SCR-37 — PRD-04 §3-1
// Written directly in the page. If this grows long enough that a non-engineer wants to edit it,
// move it to packages/content (GOV-02 TBD-44) rather than growing the markup here.
import Layout from "../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";

const STEPS = [
  { title: "参加者登録をする", body: "メールアドレスとパスワードを登録し、確認メールのリンクから登録を完了します。登録は無料です。" },
  { title: "おさんぽをさがす", body: "エリアや日付で絞り込み、参加できるおさんぽを選びます。はじめての方歓迎の枠には印が付いています。" },
  { title: "予約してお支払い", body: "参加人数と緊急連絡先を入力し、クレジットカードでお支払いいただきます。" },
  { title: "当日、集合場所へ", body: "集合場所で保護団体のスタッフと合流します。動きやすい服装でお越しください。" },
  { title: "記録を振り返る", body: "おさんぽの記録と、これまでの支援額はマイページで確認できます。" },
];
---

<Layout title="利用ガイド | 保護犬おさんぽマッチング" description="登録から当日のおさんぽまでの流れをご案内します。">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-10 px-4 py-12">
    <PageHeader title="利用ガイド" lead="はじめてご利用いただく方に向けて、登録から当日までの流れをまとめました。" />

    <ol class="grid gap-4">
      {
        STEPS.map((step, index) => (
          <li class="card relative p-6 pt-8">
            <span class="absolute -top-4 left-6 grid size-9 place-items-center rounded-full bg-brand-blossom-deep font-bold text-white tabular-nums" aria-hidden="true">
              {index + 1}
            </span>
            <h2 class="text-lg font-bold text-balance">{step.title}</h2>
            <p class="mt-2 leading-relaxed text-pretty text-brand-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="text-sm text-pretty text-brand-ink-soft">
      当日の安全上の注意は
      <a href="/safety" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">安全に利用するために</a>
      をご覧ください。
    </p>
  </main>
</Layout>

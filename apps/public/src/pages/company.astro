---
// SCR-47 運営会社 — PRD-04 §3-1
// TODO(SCR-47): fill in the operating entity once it is registered — GOV-02 TBD-35.
import Layout from "../layouts/Layout.astro";
---

<Layout title="運営会社">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">運営会社</h1>

    <dl class="grid gap-3 text-sm">
      <div><dt class="font-semibold">会社名</dt> <dd class="text-gray-600">（確定後に記載）</dd></div>
      <div><dt class="font-semibold">所在地</dt> <dd class="text-gray-600">（確定後に記載）</dd></div>
      <div><dt class="font-semibold">事業内容</dt> <dd class="text-gray-600">保護犬とのお散歩体験のマッチング、保護団体への支援</dd></div>
      <div><dt class="font-semibold">お問い合わせ</dt> <dd class="text-gray-600"><a href="/contact" class="underline">お問い合わせフォーム</a></dd></div>
    </dl>

    <p class="text-sm text-gray-600">法定表記は<a href="/law" class="underline">特定商取引法に基づく表示</a>をご覧ください。</p>
  </main>
</Layout>

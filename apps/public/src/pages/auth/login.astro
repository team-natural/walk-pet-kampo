---
// SCR-11 — PRD-04 §3-1
// Not `/` like apps/admin: there the whole site is behind auth, here `/` is the public top page.
import Layout from "../../layouts/Layout.astro";
import LoginForm from "../../lib/components/login-form.svelte";
import { getSession } from "$lib/server/auth/session";
import { createDb } from "@app/schema/client";
import { env } from "cloudflare:workers";

const session = await getSession(Astro.cookies, createDb(env.DB));
if (session) return Astro.redirect("/mypage", 302);

// Set by the password reset (SCR-14), which sends the walker here rather than signing them in.
const passwordReset = Astro.url.searchParams.get("status") === "password_reset";
---

<Layout title="ログイン | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-md gap-6 px-4 py-16">
    <h1 class="text-2xl font-bold">ログイン</h1>

    {
      passwordReset && (
        <p role="status" class="rounded-2xl border-2 border-brand-blossom/60 bg-brand-blossom/20 px-4 py-3 text-sm font-bold">
          パスワードを変更しました。新しいパスワードでログインしてください。
        </p>
      )
    }

    <div class="card p-6 sm:p-8">
      <LoginForm client:load />
    </div>

    <div class="grid gap-2 text-sm">
      <a href="/auth/forgot-password" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">パスワードをお忘れの方</a>
      <p class="text-brand-ink-soft">
        はじめての方は
        <a href="/register" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">参加者登録</a>
        から。
      </p>
    </div>
  </main>
</Layout>

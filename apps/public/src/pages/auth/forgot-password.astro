---
// SCR-13 — PRD-04 §3-1
// TODO(SCR-13): post to requestWalkerPasswordReset() — F-01-04.
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
---

<Layout title="パスワードの再設定 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-md gap-6 px-4 py-16">
    <PageHeader title="パスワードの再設定" lead="ご登録のメールアドレスに、再設定用のリンクをお送りします。" backHref="/auth/login" backLabel="ログイン" />

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action="/api/v1/auth/password/forgot">
      <label class="grid gap-1.5">
        <span class="font-bold">メールアドレス</span>
        <input type="email" name="email" required autocomplete="username" spellcheck="false" class="field w-full" />
      </label>
      <button type="submit" class="btn btn-blossom px-6 py-3">再設定メールを送る</button>
    </form>

    <p class="text-sm text-pretty text-brand-ink-soft">登録されていないメールアドレスの場合もメールは送信されません。数分たっても届かない場合は、入力内容をご確認ください。</p>
  </main>
</Layout>

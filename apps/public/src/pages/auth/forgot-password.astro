---
// SCR-13 — PRD-04 §3-1
// TODO(SCR-13): post to requestWalkerPasswordReset() — F-01-04.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="パスワードの再設定">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col justify-center gap-6 p-6">
    <h1 class="text-2xl font-bold">パスワードの再設定</h1>
    <p class="text-sm text-gray-600">ご登録のメールアドレスに再設定用のリンクをお送りします。</p>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/auth/password/forgot">
      <label class="grid gap-1">
        <span>メールアドレス</span>
        <input type="email" name="email" required class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">再設定メールを送る</button>
    </form>
  </main>
</Layout>

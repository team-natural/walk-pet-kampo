---
// SCR-12 — PRD-04 §3-1
// TODO(SCR-12): exchange the provider code for a walker session — F-01-07.
import Layout from "../../../layouts/Layout.astro";
import CompletionPanel from "$lib/components/completion-panel.astro";

const { provider } = Astro.params;
---

<Layout title="ログイン処理中 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16" data-provider={provider}>
    <CompletionPanel tone="attention" title="ログイン処理中です" message="このまましばらくお待ちください。画面が切り替わらない場合は、お手数ですがもう一度ログインしてください。" actionHref="/auth/login" actionLabel="ログイン画面へ" />
  </main>
</Layout>

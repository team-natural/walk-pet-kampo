---
// SCR-12 — PRD-04 §3-1
// TODO(SCR-12): exchange the provider code for a walker session — F-01-07.
import Layout from "../../../layouts/Layout.astro";

const { provider } = Astro.params;
---

<Layout title="ログイン処理中">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center gap-4 p-6 text-center" data-provider={provider}>
    <h1 class="text-2xl font-bold">ログイン処理中です</h1>
    <p class="text-sm text-gray-600">画面が切り替わらない場合は、お手数ですがもう一度ログインしてください。</p>
    <a href="/auth/login" class="underline">ログイン画面へ</a>
  </main>
</Layout>

---
// SCR-04 — PRD-04 §3-1 (F-07-02)
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import PageHeader from "$lib/components/page-header.astro";
import { adoptionStatusLabel, dogSizeLabel } from "$lib/dog-status";
import { imageUrl } from "$lib/images";
import { listPublishedDogs } from "$lib/server/services/dogs";
import type { DogSummary } from "$lib/view-models/dog";
import { createDb } from "@app/schema/client";

const keyword = Astro.url.searchParams.get("q");
const walkEligibleOnly = Astro.url.searchParams.get("walkable") === "1";
const dogs: DogSummary[] = await listPublishedDogs(createDb(env.DB), { keyword, walkEligibleOnly });
---

<Layout title="保護犬をさがす | 保護犬おさんぽマッチング" description="おさんぽに参加できる保護犬の一覧です。性格や散歩時の注意を見てから選べます。">
  <main id="main-content" class="mx-auto grid max-w-6xl gap-8 px-4 py-12">
    <PageHeader title="保護犬をさがす" lead="おさんぽに参加できる子の一覧です。性格や散歩のときの注意は、それぞれの詳細ページに書いてあります。" />

    <form action="/dogs" method="get" role="search" aria-label="保護犬の検索" class="card grid gap-3 p-4">
      <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
        <label>
          <span class="sr-only">名前・犬種・団体名</span>
          <input type="search" name="q" value={keyword} autocomplete="off" spellcheck="false" placeholder="名前・犬種・団体名" class="field w-full" />
        </label>
        <button type="submit" class="btn btn-blossom px-6">さがす</button>
      </div>

      <label class="flex items-center gap-2 px-1 text-sm">
        <input type="checkbox" name="walkable" value="1" checked={walkEligibleOnly} class="size-5 accent-brand-blossom-deep" />
        <span>おさんぽに参加できる子だけ</span>
      </label>
    </form>

    {
      dogs.length > 0 ? (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {dogs.map((dog, index) => (
            <li class="anim-rise card p-6" style={`--delay: ${index * 0.06}s`}>
              {dog.photoKey && <img src={imageUrl(dog.photoKey)} alt="" width="480" height="320" loading="lazy" class="mb-4 h-44 w-full rounded-2xl object-cover" />}
              <h2 class="line-clamp-2 text-lg font-bold text-balance">
                <a href={`/dogs/${dog.slug}`} class="rounded underline-offset-4 hover:underline">
                  {dog.name}
                </a>
              </h2>
              <p class="mt-2 text-sm text-brand-ink-soft">{[dog.breed, dogSizeLabel(dog.size), dog.estimatedAge].filter(Boolean).join(" / ")}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {dog.walkEligible === 1 && <span class="badge badge-blossom">おさんぽ参加中</span>}
                <span class="badge badge-quiet">{adoptionStatusLabel(dog.adoptionStatus)}</span>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="いま掲載中の保護犬はいません。" actionHref="/organizations" actionLabel="参加している保護団体を見る" />
      )
    }
  </main>
</Layout>

---
// SCR-49 里親相談フォーム — PRD-04 §3-1（認証必要）
// An independent page rather than a modal on SCR-05, so a signed-out visitor can be redirected
// here after logging in (PRD-04 §3-1 の注記).
// TODO(SCR-49): replace mockDogDetail with getDogBySlug() and post createAdoptionInquiry() — F-11-01.
import { env } from "cloudflare:workers";
import Layout from "../../../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockDogDetail } from "$lib/mocks";
import type { DogDetail } from "$lib/view-models/dog";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const { slug } = Astro.params;
const dog: DogDetail = mockDogDetail;
---

<Layout title={`${dog.name} の里親相談`}>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">{dog.name} の里親について相談する</h1>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/adoption-inquiries">
      <input type="hidden" name="dogSlug" value={slug} />
      <label class="grid gap-1">
        <span>希望理由</span>
        <textarea name="motivation" rows="5" required class="rounded border border-gray-300 px-3 py-2"></textarea>
      </label>
      <label class="grid gap-1">
        <span>飼育環境</span>
        <textarea name="livingEnvironment" rows="5" required class="rounded border border-gray-300 px-3 py-2"></textarea>
      </label>
      <p class="text-gray-600">相談内容と連絡先は相談先の保護団体にのみ共有されます。</p>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">送信する</button>
    </form>
  </main>
</Layout>

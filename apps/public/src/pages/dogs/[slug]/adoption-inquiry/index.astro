---
// SCR-49 — PRD-04 §3-1 (guarded)
// An independent page rather than a modal on SCR-05, so a signed-out visitor can be redirected
// here after logging in (PRD-04 §3-1, note).
// TODO(SCR-49): replace mockDogDetail with getDogBySlug() and post createAdoptionInquiry() — F-11-01.
import { env } from "cloudflare:workers";
import Layout from "../../../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { mockDogDetail } from "$lib/mocks";
import type { DogDetail } from "$lib/view-models/dog";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const { slug } = Astro.params;
const dog: DogDetail = mockDogDetail;
---

<Layout title={`${dog.name} の里親相談 | 保護犬おさんぽマッチング`}>
  <main id="main-content" class="mx-auto grid max-w-2xl gap-6 px-4 py-12">
    <PageHeader title={`${dog.name} の里親について相談する`} lead="保護団体に直接届きます。相談したからといって、里親になる義務はありません。" backHref={`/dogs/${slug}`} backLabel={dog.name} />

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action={`/api/v1/dogs/${slug}/adoption-inquiries`}>
      <label class="grid gap-1.5">
        <span class="font-bold">希望理由</span>
        <textarea name="motivation" rows="5" required class="field w-full rounded-2xl"></textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">飼育環境</span>
        <textarea name="livingEnvironment" rows="5" required class="field w-full rounded-2xl"></textarea>
        <span class="text-pretty text-brand-ink-soft">住まいの形態、同居されるご家族、在宅の時間などをお書きください。</span>
      </label>

      <p class="text-pretty text-brand-ink-soft">相談内容と連絡先は、相談先の保護団体にのみ共有されます。住所などの詳細は開示されません。</p>

      <button type="submit" class="btn btn-blossom px-6 py-3">送信する</button>
    </form>
  </main>
</Layout>

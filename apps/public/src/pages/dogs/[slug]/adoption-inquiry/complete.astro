---
// SCR-50 — PRD-04 §3-1 (guarded)
import { env } from "cloudflare:workers";
import Layout from "../../../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);
---

<Layout title="相談を送信しました">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center gap-4 p-6 text-center">
    <h1 class="text-2xl font-bold">相談を送信しました</h1>
    <p class="text-sm text-gray-600">保護団体から直接ご連絡があります。やり取りの状況はマイページで確認できます。</p>
    <a href="/mypage/adoption-inquiries" class="underline">相談の一覧へ</a>
  </main>
</Layout>

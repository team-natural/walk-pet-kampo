---
// SCR-40 — PRD-04 §3-1
// TODO(SCR-40): replace the placeholder sections with the reviewed text and bump PRIVACY_VERSION
// in the same commit — DEV-02 §8, OPS-01.
import Layout from "../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { PRIVACY_VERSION } from "$lib/legal";
---

<Layout title="プライバシーポリシー | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-8 px-4 py-12">
    <PageHeader title="プライバシーポリシー">
      <p class="text-sm text-brand-ink-soft tabular-nums">制定日 {PRIVACY_VERSION}</p>
    </PageHeader>

    <article class="card prose-jp max-w-none p-6 sm:p-10">
      <h2>取得する情報</h2>
      <p>氏名、メールアドレス、電話番号、住所、緊急連絡先、おさんぽの参加履歴を取得します。</p>

      <h2>利用目的</h2>
      <p>おさんぽの予約と実施、当日の安全管理、決済および保護団体への還元のために利用します。</p>

      <h2>第三者提供</h2>
      <p>緊急連絡先は、予約が確定したおさんぽの担当スタッフにのみ開示します。里親相談の内容は、相談先の保護団体にのみ共有します。</p>

      <h2>保存期間</h2>
      <p>退会後、一定期間を経過した情報は削除します。</p>

      <h2>お問い合わせ</h2>
      <p>個人情報の開示・訂正・削除のご請求は、お問い合わせフォームから承ります。</p>
    </article>
  </main>
</Layout>

---
// SCR-02 参加保護団体一覧 — PRD-04 §3-1
// Reference skeleton for a PUBLIC list screen: no guard, view model imported, mock data named
// exactly once so the Service call replaces a single line.
// TODO(SCR-02): replace mockOrganizations with listOrganizations() — F-07-01.
import Layout from "../../layouts/Layout.astro";
import { mockOrganizations } from "$lib/mocks";
import type { OrganizationSummary } from "$lib/view-models/organization";

const organizations: OrganizationSummary[] = mockOrganizations;
---

<Layout title="参加保護団体">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-8 p-6">
    <header class="flex flex-col gap-2">
      <h1 class="text-2xl font-bold">参加保護団体</h1>
      <p class="text-sm text-gray-600">お散歩の受け入れをしている保護団体の一覧です。</p>
    </header>

    <ul class="grid gap-4">
      {
        organizations.map((organization) => (
          <li class="rounded border border-gray-200 p-4">
            <a href={`/organizations/${organization.slug}`} class="font-semibold">
              {organization.name}
            </a>
            <p class="text-sm text-gray-600">{organization.activityArea}</p>
            <p class="text-sm text-gray-600">保護中 {organization.protectedDogCount} 頭</p>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

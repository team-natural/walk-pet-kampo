---
// SCR-03 — PRD-04 §3-1
// TODO(SCR-03): replace the mocks with getOrganizationBySlug() / listDogs() / listWalkSlots() — F-07-01.
import Layout from "../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import PageHeader from "$lib/components/page-header.astro";
import { mockDogs, mockOrganizationDetail, mockWalkSlots } from "$lib/mocks";
import { formatYen } from "$lib/pricing";
import type { DogSummary } from "$lib/view-models/dog";
import type { OrganizationDetail } from "$lib/view-models/organization";
import type { WalkSlotSummary } from "$lib/view-models/walk-slot";

const { slug } = Astro.params;
const organization: OrganizationDetail = mockOrganizationDetail;
const dogs: DogSummary[] = mockDogs;
const walkSlots: WalkSlotSummary[] = mockWalkSlots;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<Layout title={`${organization.name} | 保護犬おさんぽマッチング`} description={organization.introduction ?? undefined}>
  <main id="main-content" class="mx-auto grid max-w-5xl gap-10 px-4 py-12" data-slug={slug}>
    <PageHeader title={organization.name} lead={organization.introduction ?? undefined} backHref="/organizations" backLabel="参加保護団体">
      <p class="text-sm font-bold text-brand-ink-soft">{organization.activityArea}</p>
    </PageHeader>

    <div class="card grid gap-0 p-6 sm:p-8">
      <dl class="detail-list">
        <div>
          <dt>代表者</dt>
          <dd>{organization.representativeName}</dd>
        </div>
        <div>
          <dt>活動開始</dt>
          <dd>{organization.activityStartedOn}</dd>
        </div>
        <div>
          <dt>譲渡実績</dt>
          <dd>{organization.adoptionTrackRecord}</dd>
        </div>
        {
          organization.website && (
            <div>
              <dt>ウェブサイト</dt>
              <dd>
                <a href={organization.website} class="rounded text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">
                  {organization.website}
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <section class="grid gap-5">
      <h2 class="text-xl font-bold text-balance">募集中のおさんぽ</h2>
      {
        walkSlots.length > 0 ? (
          <ul class="grid gap-5 sm:grid-cols-2">
            {walkSlots.map((slot) => (
              <li class="card flex flex-col p-6">
                <p class="text-sm font-bold text-brand-ink-soft">
                  <time datetime={slot.startAt}>{dateFormat.format(new Date(slot.startAt))}</time>
                </p>
                <h3 class="mt-2 line-clamp-2 text-lg font-bold text-balance">
                  <a href={`/walks/${slot.id}`} class="rounded underline-offset-4 hover:underline">
                    {slot.title}
                  </a>
                </h3>
                <p class="mt-3 font-bold whitespace-nowrap tabular-nums">{formatYen(slot.feePerPerson)} / 名</p>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState message="この団体がいま募集しているおさんぽはありません。" actionHref="/walks" actionLabel="ほかのおさんぽを見る" />
        )
      }
    </section>

    <section class="grid gap-5">
      <h2 class="text-xl font-bold text-balance">この団体の保護犬</h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          dogs.map((dog) => (
            <li class="card p-6">
              <h3 class="line-clamp-2 text-lg font-bold text-balance">
                <a href={`/dogs/${dog.slug}`} class="rounded underline-offset-4 hover:underline">
                  {dog.name}
                </a>
              </h3>
              <p class="mt-2 text-sm text-brand-ink-soft">
                {dog.breed} / {dog.size}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

---
// SCR-36 — PRD-04 §3-1
// The entries come from lib/faq.ts, not D1 (GOV-01 D-016), so there is no Service to swap in and
// no TODO here — this screen is complete.
import Layout from "../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { FAQ } from "$lib/faq";

const categories = [...new Set(FAQ.map((entry) => entry.category))];
---

<Layout title="よくある質問 | 保護犬おさんぽマッチング" description="おさんぽへの参加、料金、キャンセル、里親相談についてよくいただく質問をまとめました。">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-10 px-4 py-12">
    <PageHeader title="よくある質問" lead="ここにない疑問は、お問い合わせからお気軽にご連絡ください。" />

    {
      categories.map((category) => (
        <section class="grid gap-4">
          <h2 class="text-lg font-bold text-balance">{category}</h2>
          <dl class="grid gap-3">
            {FAQ.filter((entry) => entry.category === category).map((entry) => (
              <div class="card p-6">
                <dt class="font-bold text-pretty">{entry.question}</dt>
                <dd class="mt-2 leading-relaxed text-pretty text-brand-ink-soft">{entry.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <p class="text-sm text-brand-ink-soft">
      解決しない場合は
      <a href="/contact" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">お問い合わせ</a>
      へ。
    </p>
  </main>
</Layout>

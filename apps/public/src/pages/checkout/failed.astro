---
// SCR-20 — PRD-04 §3-1 (guarded)
// The reservation stays awaiting_payment and is not cancelled here — the walker is invited to pay
// again, and the slot is released by expires_at if they do not (GOV-01 D-025, DEV-10 §2-2).
// TODO(SCR-20): replace mockReservationDetail with getReservationByPublicId() — F-08-01.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import CompletionPanel from "$lib/components/completion-panel.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="お支払いが完了しませんでした | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16">
    <CompletionPanel tone="attention" title="お支払いが完了しませんでした" message="予約はまだ確定していませんが、枠は一定時間おさえてあります。お手数ですが、もう一度お支払いをお試しください。" actionHref="/checkout" actionLabel="お支払いをやり直す">
      <p class="text-sm font-bold text-brand-ink-soft">{reservation.walkSlot.title}</p>
    </CompletionPanel>
  </main>
</Layout>

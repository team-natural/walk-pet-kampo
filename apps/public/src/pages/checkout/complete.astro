---
// SCR-19 — PRD-04 §3-1 (guarded)
// The reservation is not confirmed here: Stripe's webhook moves it to confirmed (DEV-10 §2-2),
// so this screen reports that payment was accepted, not that the booking is final.
// TODO(SCR-19): replace mockReservationDetail with getReservationByPublicId() — F-08-02.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import CompletionPanel from "$lib/components/completion-panel.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="お支払いが完了しました | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16">
    <CompletionPanel title="お支払いが完了しました" message="予約の確定処理が終わりしだい、メールでお知らせします。確定まで少し時間がかかることがあります。" actionHref={`/mypage/reservations/${reservation.id}`} actionLabel="予約の詳細を見る">
      <p class="text-sm font-bold text-brand-ink-soft">{reservation.walkSlot.title}</p>
    </CompletionPanel>
  </main>
</Layout>

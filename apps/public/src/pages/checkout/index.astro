---
// SCR-18 — PRD-04 §3-1 (guarded)
// TODO(SCR-18): replace mockReservationDetail with getPendingReservation() and start the Stripe
// Checkout Session — F-07-06, F-08-01.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import { CANCELLATION, formatYen } from "$lib/pricing";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservation: ReservationDetail = mockReservationDetail;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "long", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<Layout title="予約内容の確認 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-2xl gap-6 px-4 py-12">
    <PageHeader title="予約内容の確認" lead="内容をご確認のうえ、お支払いにお進みください。" />

    <div class="card p-6 sm:p-8">
      <dl class="detail-list">
        <div>
          <dt>おさんぽ</dt>
          <dd class="font-bold text-pretty">{reservation.walkSlot.title}</dd>
        </div>
        <div>
          <dt>開催</dt>
          <dd>{dateFormat.format(new Date(reservation.walkSlot.startAt))}</dd>
        </div>
        <div>
          <dt>参加人数</dt>
          <dd class="tabular-nums">{reservation.participantCount} 名</dd>
        </div>
        <div>
          <dt>緊急連絡先</dt>
          <dd>{reservation.emergencyContactNameSnapshot}（{reservation.emergencyContactPhoneSnapshot}）</dd>
        </div>
        <div>
          <dt>お支払い額</dt>
          <dd class="text-xl font-bold whitespace-nowrap tabular-nums">{formatYen(reservation.payment?.amount ?? 0)}</dd>
        </div>
      </dl>
    </div>

    <form method="post" action={`/api/v1/reservations/${reservation.id}/checkout-session`} class="grid gap-3">
      <button type="submit" class="btn btn-blossom px-6 py-3">お支払いに進む</button>
      <p class="text-sm text-pretty text-brand-ink-soft">開催の {CANCELLATION.freeCancellationHours} 時間前までのキャンセルは全額返金します。お支払いは外部の決済画面で行います。</p>
    </form>
  </main>
</Layout>

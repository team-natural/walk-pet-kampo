---
// SCR-18 — PRD-04 §3-1 (guarded)
// TODO(SCR-18): replace mockReservationDetail with getPendingReservation() and start the Stripe
// Checkout Session — F-07-06, F-08-01.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="予約内容の確認">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">予約内容の確認</h1>

    <dl class="grid gap-1 text-sm">
      <div><dt class="inline text-gray-500">お散歩</dt> <dd class="inline">{reservation.walkSlot.title}</dd></div>
      <div><dt class="inline text-gray-500">開催</dt> <dd class="inline">{reservation.walkSlot.startAt}</dd></div>
      <div><dt class="inline text-gray-500">人数</dt> <dd class="inline">{reservation.participantCount} 名</dd></div>
      <div><dt class="inline text-gray-500">お支払い</dt> <dd class="inline">{reservation.payment?.amount} 円</dd></div>
      <div><dt class="inline text-gray-500">緊急連絡先</dt> <dd class="inline">{reservation.emergencyContactNameSnapshot}（{reservation.emergencyContactPhoneSnapshot}）</dd></div>
    </dl>

    <form method="post" action={`/api/v1/reservations/${reservation.id}/checkout-session`}>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2 text-sm">お支払いに進む</button>
    </form>
  </main>
</Layout>

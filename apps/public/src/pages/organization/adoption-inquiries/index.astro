---
// ADM-20 — PRD-04 §3-2 (guarded)
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { adoptionInquiryStatusLabel } from "$lib/adoption-inquiry-status";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { listOrganizationInquiries } from "$lib/server/services/adoption-inquiries";
import type { AdoptionInquirySummary } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const inquiries: AdoptionInquirySummary[] = await listOrganizationInquiries(db, session.organizationId);

const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "numeric", day: "numeric", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="里親相談 | 団体ページ" session={session}>
  <FlashMessage />

  <h1 class="text-xl font-bold">里親相談</h1>

  <DataTable columns={["保護犬", "受付日", "状態"]} rowCount={inquiries.length} caption="受け付けた里親相談の一覧" emptyMessage="まだ里親相談は届いていません。" emptyActionHref="/organization/dogs" emptyActionLabel="保護犬を見る">
    {
      inquiries.map((inquiry) => (
        <tr>
          <td>
            <a href={`/organization/adoption-inquiries/${inquiry.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {inquiry.dog.name}
            </a>
          </td>
          <td class="tabular-nums">{dateFormat.format(new Date(inquiry.createdAt))}</td>
          <td>
            <span class="badge badge-quiet">{adoptionInquiryStatusLabel(inquiry.status)}</span>
          </td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

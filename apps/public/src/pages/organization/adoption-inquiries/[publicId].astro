---
// ADM-21 — PRD-04 §3-2 (guarded)
// Only the enquiry text and contact details are disclosed; the walker's address is not
// (GOV-02 TBD-34). The Service decides that, not this template.
// TODO(ADM-21): replace mockAdoptionInquiryDetail with getOwnAdoptionInquiry() and post
// transitionAdoptionInquiry() — F-11-02, F-11-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockAdoptionInquiryDetail } from "$lib/mocks";
import type { AdoptionInquiryDetail } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;
const inquiry: AdoptionInquiryDetail = mockAdoptionInquiryDetail;
---

<OrganizationLayout title="里親相談の詳細 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="grid gap-2" data-public-id={publicId}>
    <a href="/organization/adoption-inquiries" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 里親相談</a>
    <h1 class="text-xl font-bold">{inquiry.dog.name} への相談</h1>
    <p><span class="badge badge-quiet">{inquiry.status}</span></p>
  </header>

  <div class="card max-w-2xl p-6 sm:p-8">
    <dl class="detail-list">
      <div>
        <dt>希望理由</dt>
        <dd class="text-pretty">{inquiry.motivation}</dd>
      </div>
      <div>
        <dt>飼育環境</dt>
        <dd class="text-pretty">{inquiry.livingEnvironment}</dd>
      </div>
      <div>
        <dt>連絡済み</dt>
        <dd>{inquiry.organizationContactedAt ?? "未連絡"}</dd>
      </div>
    </dl>
  </div>

  <form class="flex max-w-2xl flex-wrap gap-3" method="post" action={`/api/v1/organization/adoption-inquiries/${inquiry.id}/transition`}>
    <button type="submit" name="to" value="contacted" class="btn btn-sun px-5 text-sm">連絡済みにする</button>
    <button type="submit" name="to" value="interview_scheduled" class="btn btn-quiet px-5 text-sm">面談予定にする</button>
    <button type="submit" name="to" value="closed" class="btn btn-quiet px-5 text-sm">終了にする</button>
  </form>

  <p class="max-w-2xl text-sm text-pretty text-brand-ink-soft">相談者への連絡はサービス外で直接行ってください。運営は仲介しません。</p>
</OrganizationLayout>

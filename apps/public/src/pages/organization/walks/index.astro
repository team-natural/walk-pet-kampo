---
// ADM-08 — PRD-04 §3-2 (guarded)
// TODO(ADM-08): replace mockWalkSlots with listOwnWalkSlots() — F-06-01.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockWalkSlots } from "$lib/mocks";
import type { WalkSlotSummary } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const walkSlots: WalkSlotSummary[] = mockWalkSlots;
---

<Layout title="お散歩募集">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold">お散歩募集</h1>
      <a href="/organization/walks/add" class="text-sm underline">募集を作成する</a>
    </header>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">タイトル</th>
          <th class="py-2">開催</th>
          <th class="py-2">定員</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          walkSlots.map((slot) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/organization/walks/${slot.id}`}>{slot.title}</a>
              </td>
              <td class="py-2">{slot.startAt}</td>
              <td class="py-2">
                {slot.capacity - slot.remainingCapacity} / {slot.capacity}
              </td>
              <td class="py-2">{slot.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

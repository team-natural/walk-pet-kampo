---
// ADM-08 — PRD-04 §3-2 (guarded)
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { listOwnWalkSlots } from "$lib/server/services/walk-slots";
import { walkSlotStatusLabel } from "$lib/walk-slot-status";
import type { WalkSlotSummary } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const walkSlots: WalkSlotSummary[] = await listOwnWalkSlots(db, session.organizationId);

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="おさんぽ募集 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-bold">おさんぽ募集</h1>
    <a href="/organization/walks/add" class="btn btn-sun px-5 text-sm">募集を作成する</a>
  </header>

  <DataTable columns={["タイトル", "開催", "予約", "状態"]} rowCount={walkSlots.length} caption="登録されているおさんぽ募集の一覧" emptyMessage="まだおさんぽ募集を作成していません。" emptyActionHref="/organization/walks/add" emptyActionLabel="募集を作成する">
    {
      walkSlots.map((slot) => (
        <tr>
          <td>
            <a href={`/organization/walks/${slot.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {slot.title}
            </a>
          </td>
          <td class="tabular-nums">{dateFormat.format(new Date(slot.startAt))}</td>
          <td class="tabular-nums">
            {slot.capacity - slot.remainingCapacity} / {slot.capacity}
          </td>
          <td>
            <span class="badge badge-quiet">{walkSlotStatusLabel(slot.status)}</span>
          </td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

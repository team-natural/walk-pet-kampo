---
// ADM-10 — PRD-04 §3-2 (guarded)
// Cancelling notifies everyone already booked, so it goes through the shared confirm dialog and
// the copy says what happens before the click (PRD-04 §4-3, GOV-01 D-019).
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import ConfirmDialog from "$lib/components/organization/confirm-dialog.svelte";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { isoToJstLocal } from "$lib/datetime";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { listOwnDogs } from "$lib/server/services/dogs";
import { allowedWalkSlotTransitions, getOwnWalkSlot } from "$lib/server/services/walk-slots";
import { walkSlotStatusLabel } from "$lib/walk-slot-status";
import type { WalkSlotDetail } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";
import { NotFoundError } from "@app/server-kit/http";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;

let slot: WalkSlotDetail;
try {
  slot = await getOwnWalkSlot(db, session.organizationId, publicId!);
} catch (error) {
  if (error instanceof NotFoundError) return Astro.rewrite("/404");
  throw error;
}

const dogs = (await listOwnDogs(db, session.organizationId)).filter((dog) => dog.walkEligible === 1);
const selectedDogIds = new Set(slot.dogs.map((dog) => dog.id));

// Cancelling has its own endpoint and its own copy, so it is not offered as a plain status move.
const nextStatuses = allowedWalkSlotTransitions(slot.status).filter((status) => status !== "cancelled" && status !== "completed" && status !== "full");
const cancellable = allowedWalkSlotTransitions(slot.status).includes("cancelled");

const ERRORS: Record<string, string> = {
  state: "この募集の状態が変わっています。画面を読み込み直してください。",
  input: "入力内容を確認してください。定員はすでに入っている予約数より少なくできません。",
};
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
---

<OrganizationLayout title={`${slot.title} | 団体ページ`} session={session}>
  <FlashMessage />

  {
    error && (
      <p role="alert" class="rounded-2xl border-2 border-brand-sun/70 bg-brand-sun/25 px-4 py-3 text-sm font-bold">
        {error}
      </p>
    )
  }

  <header class="grid gap-2" data-public-id={publicId}>
    <a href="/organization/walks" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← おさんぽ募集</a>
    <h1 class="text-xl font-bold">{slot.title}</h1>
    <p class="flex flex-wrap items-center gap-2">
      <span class="badge badge-quiet">{walkSlotStatusLabel(slot.status)}</span>
      <span class="badge badge-blossom tabular-nums">残り {slot.remainingCapacity} / {slot.capacity} 名</span>
      {
        ["open", "full", "closed"].includes(slot.status) && (
          <a href={`/walks/${slot.id}`} class="rounded text-sm text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">
            公開ページを見る
          </a>
        )
      }
    </p>
  </header>

  {
    nextStatuses.length > 0 && (
      <section class="card grid max-w-2xl gap-3 p-6">
        <h2 class="font-bold">公開の状態</h2>
        <div class="flex flex-wrap gap-2">
          {nextStatuses.map((status) => (
            <form method="post" action={`/api/v1/organization/walk-slots/${slot.id}/status`}>
              <input type="hidden" name="to" value={status} />
              <button type="submit" class="btn btn-quiet px-4 text-sm">
                {walkSlotStatusLabel(status)}にする
              </button>
            </form>
          ))}
        </div>
      </section>
    )
  }

  <form class="grid max-w-2xl gap-4" method="post" action={`/api/v1/organization/walk-slots/${slot.id}`}>
    <FormSection legend="開催の内容">
      <label class="grid gap-1.5">
        <span class="font-bold">タイトル</span>
        <input type="text" name="title" value={slot.title} required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">紹介文</span>
        <textarea name="description" rows="3" class="field w-full rounded-2xl">{slot.description}</textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">開催日時</span>
        <input type="datetime-local" name="startAt" value={isoToJstLocal(slot.startAt)} required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">所要時間（分）</span>
        <input type="number" name="durationMinutes" value={slot.durationMinutes} min="15" required class="field w-full tabular-nums" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">集合場所</span>
        <input type="text" name="meetingPlace" value={slot.meetingPlace} required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">都道府県</span>
        <input type="text" name="areaPrefecture" value={slot.areaPrefecture} required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">市区町村</span>
        <input type="text" name="areaCity" value={slot.areaCity} class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">定員</span>
        <input type="number" name="capacity" value={slot.capacity} min={slot.capacity - slot.remainingCapacity || 1} required class="field w-full tabular-nums" />
      </label>
    </FormSection>

    <FormSection legend="受付期間">
      <label class="grid gap-1.5">
        <span class="font-bold">受付開始</span>
        <input type="datetime-local" name="acceptanceStartAt" value={isoToJstLocal(slot.acceptanceStartAt)} required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">受付終了</span>
        <input type="datetime-local" name="acceptanceEndAt" value={isoToJstLocal(slot.acceptanceEndAt)} required class="field w-full" />
      </label>
    </FormSection>

    <FormSection legend="参加する保護犬" description="おさんぽに参加できる設定の子だけが選べます。">
      <div class="grid gap-2">
        {
          dogs.map((dog) => (
            <label class="flex items-center gap-3">
              <input type="checkbox" name="dogIds" value={dog.id} checked={selectedDogIds.has(dog.id)} class="size-5 accent-brand-blossom-deep" />
              <span>{dog.name}</span>
            </label>
          ))
        }
      </div>
    </FormSection>

    <FormSection legend="参加条件">
      <label class="grid gap-1.5">
        <span class="font-bold">必要な経験</span>
        <select name="requiredExperience" class="field w-full">
          <option value="none" selected={slot.requiredExperience === "none"}>不問</option>
          <option value="some" selected={slot.requiredExperience === "some"}>多少あると安心</option>
          <option value="experienced" selected={slot.requiredExperience === "experienced"}>経験者のみ</option>
        </select>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">参加できる年齢（歳以上）</span>
        <input type="number" name="minAge" value={slot.minAge} min="0" max="100" class="field w-full tabular-nums" />
      </label>

      <label class="flex items-center gap-3">
        <input type="hidden" name="staffAccompanied" value="0" />
        <input type="checkbox" name="staffAccompanied" value="1" checked={slot.staffAccompanied === 1} class="size-5 accent-brand-blossom-deep" />
        <span>スタッフが同行する</span>
      </label>

      <label class="flex items-center gap-3">
        <input type="hidden" name="beginnerAllowed" value="0" />
        <input type="checkbox" name="beginnerAllowed" value="1" checked={slot.beginnerAllowed === 1} class="size-5 accent-brand-blossom-deep" />
        <span>はじめての方でも参加できる</span>
      </label>

      <label class="flex items-center gap-3">
        <input type="hidden" name="childAllowed" value="0" />
        <input type="checkbox" name="childAllowed" value="1" checked={slot.childAllowed === 1} class="size-5 accent-brand-blossom-deep" />
        <span>お子さま同伴で参加できる</span>
      </label>
    </FormSection>

    <FormSection legend="参加者への案内">
      <label class="grid gap-1.5">
        <span class="font-bold">持ち物・服装</span>
        <input type="text" name="clothingNotes" value={slot.clothingNotes} class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">注意事項</span>
        <textarea name="precautions" rows="3" class="field w-full rounded-2xl">{slot.precautions}</textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">雨天時の対応</span>
        <input type="text" name="weatherPolicy" value={slot.weatherPolicy} class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">キャンセルについて</span>
        <textarea name="cancellationPolicy" rows="3" class="field w-full rounded-2xl">{slot.cancellationPolicy}</textarea>
      </label>
    </FormSection>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">保存する</button>
  </form>

  {
    cancellable && (
      <section class="card grid max-w-2xl gap-3 border-2 border-red-200 p-6">
        <h2 class="font-bold text-red-800">開催を中止する</h2>
        <p class="text-sm text-pretty text-brand-ink-soft">予約済みの参加者全員に中止の通知が送られ、参加費は全額返金されます。取り消せません。</p>
        <form id="cancel-walk-form" method="post" action={`/api/v1/organization/walk-slots/${slot.id}/cancel`} class="grid gap-1.5 text-sm">
          <label class="grid gap-1.5">
            <span class="font-bold">中止の理由</span>
            <select name="reason" class="field w-full">
              <option value="organization">団体都合</option>
              <option value="weather">天候</option>
              <option value="dog_condition">保護犬の体調</option>
            </select>
          </label>
        </form>
        <ConfirmDialog client:load form="cancel-walk-form" triggerLabel="中止する" title="このおさんぽを中止しますか？" message="予約済みの参加者全員に通知が送られ、参加費は全額返金されます。この操作は取り消せません。" confirmLabel="中止する" />
      </section>
    )
  }
</OrganizationLayout>

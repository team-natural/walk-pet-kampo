---
// ADM-10 お散歩募集詳細・編集 — PRD-04 §3-2
// Cancelling notifies everyone already booked, so the confirmation must say so before the action
// (PRD-04 §4-3). The modal itself belongs to the design phase; the skeleton states the
// consequence in text so it cannot be lost on the way there.
// TODO(ADM-10): replace mockWalkSlotDetail with getOwnWalkSlot(), post updateWalkSlot() and
// cancelWalkSlot() — F-06-01, F-06-04.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockWalkSlotDetail } from "$lib/mocks";
import type { WalkSlotDetail } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;
const slot: WalkSlotDetail = mockWalkSlotDetail;
---

<Layout title={`${slot.title} の編集`}>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6" data-public-id={publicId}>
    <h1 class="text-2xl font-bold">{slot.title}</h1>

    <form class="grid gap-4 text-sm" method="post" action={`/api/v1/organization/walk-slots/${slot.id}`}>
      <label class="grid gap-1">
        <span>タイトル</span>
        <input type="text" name="title" value={slot.title} class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>集合場所</span>
        <input type="text" name="meetingPlace" value={slot.meetingPlace} class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>注意事項</span>
        <textarea name="precautions" rows="4" class="rounded border border-gray-300 px-3 py-2">{slot.precautions}</textarea>
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">保存する</button>
    </form>

    <section class="grid gap-2 rounded border border-red-200 p-4 text-sm">
      <h2 class="font-semibold text-red-700">開催を中止する</h2>
      <p class="text-gray-600">予約済みの参加者全員に中止の通知が送られ、参加費は返金されます。</p>
      <form method="post" action={`/api/v1/organization/walk-slots/${slot.id}/cancel`}>
        <button type="submit" class="rounded border border-red-300 px-3 py-2 text-red-700">中止する</button>
      </form>
    </section>
  </main>
</Layout>

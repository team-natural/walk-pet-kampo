---
// ADM-22 通知一覧 — PRD-04 §3-2
// TODO(ADM-22): replace mockNotifications with listOrganizationNotifications() — F-13-01.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockNotifications } from "$lib/mocks";
import type { NotificationView } from "$lib/view-models/notification";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const notifications: NotificationView[] = mockNotifications;
---

<Layout title="通知">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col gap-6 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold">通知</h1>
      <a href="/organization/notification-settings" class="text-sm underline">通知設定</a>
    </header>

    <ul class="grid gap-3 text-sm">
      {
        notifications.map((notification) => (
          <li class="rounded border border-gray-200 p-4">
            <p class={notification.readAt ? "text-gray-600" : "font-semibold"}>{notification.body}</p>
            <p class="text-gray-500">{notification.createdAt}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

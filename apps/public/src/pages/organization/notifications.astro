---
// ADM-22 — PRD-04 §3-2 (guarded)
// TODO(ADM-22): replace mockNotifications with listOrganizationNotifications() — F-13-01.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockNotifications } from "$lib/mocks";
import type { NotificationView } from "$lib/view-models/notification";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const notifications: NotificationView[] = mockNotifications;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="通知 | 団体ページ" session={session}>
  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-bold">通知</h1>
    <a href="/organization/notification-settings" class="rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">通知設定</a>
  </header>

  {
    notifications.length > 0 ? (
      <ul class="grid max-w-3xl gap-3">
        {notifications.map((notification) => (
          <li class={`card p-5 text-sm ${notification.readAt ? "" : "border-2 border-brand-blossom/50"}`}>
            <p class={`text-pretty ${notification.readAt ? "text-brand-ink-soft" : "font-bold"}`}>{notification.body}</p>
            <p class="mt-2 text-brand-ink-soft tabular-nums">{dateFormat.format(new Date(notification.createdAt))}</p>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState message="新しい通知はありません。" actionHref="/organization" actionLabel="ダッシュボードへ" />
    )
  }
</OrganizationLayout>

---
// ADM-06 — PRD-04 §3-2 (guarded)
// TODO(ADM-06): post to createDog() — F-05-02.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
---

<OrganizationLayout title="保護犬の登録 | 団体ページ" session={session}>
  <header class="grid gap-2">
    <a href="/organization/dogs" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 保護犬</a>
    <h1 class="text-xl font-bold">保護犬の登録</h1>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action="/api/v1/organization/dogs" enctype="multipart/form-data">
    <FormSection legend="基本情報">
      <label class="grid gap-1.5">
        <span class="font-bold">名前</span>
        <input type="text" name="name" required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">犬種</span>
        <input type="text" name="breed" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">サイズ</span>
        <select name="size" class="field w-full">
          <option value="small">小型</option>
          <option value="medium">中型</option>
          <option value="large">大型</option>
        </select>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">写真</span>
        <input type="file" name="photo" accept="image/*" class="field w-full" />
      </label>
    </FormSection>

    <FormSection legend="おさんぽの条件" description="参加者がこの子と歩けるかどうかの判断に使われます。">
      <label class="grid gap-1.5">
        <span class="font-bold">必要な経験</span>
        <select name="requiredExperience" class="field w-full">
          <option value="none">不問</option>
          <option value="some">多少あると安心</option>
          <option value="experienced">経験者のみ</option>
        </select>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">おさんぽの注意</span>
        <textarea name="walkNotes" rows="3" class="field w-full rounded-2xl"></textarea>
      </label>
    </FormSection>

    <FormSection legend="紹介文" description="公開ページに表示されます。">
      <label class="grid gap-1.5">
        <span class="sr-only">紹介文</span>
        <textarea name="introduction" rows="5" class="field w-full rounded-2xl"></textarea>
      </label>
    </FormSection>

    <FormSection legend="団体内メモ" description="公開されません。運営と団体スタッフだけが見られます。">
      <label class="grid gap-1.5">
        <span class="sr-only">団体内メモ</span>
        <textarea name="internalNotes" rows="3" class="field w-full rounded-2xl"></textarea>
      </label>
    </FormSection>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">登録する</button>
  </form>
</OrganizationLayout>

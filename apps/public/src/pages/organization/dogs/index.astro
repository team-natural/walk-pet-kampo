---
// ADM-05 — PRD-04 §3-2 (guarded)
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { adoptionStatusLabel, dogSizeLabel } from "$lib/dog-status";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { listOwnDogs } from "$lib/server/services/dogs";
import type { DogSummary } from "$lib/view-models/dog";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const dogs: DogSummary[] = await listOwnDogs(db, session.organizationId);
---

<OrganizationLayout title="保護犬 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-bold">保護犬</h1>
    <a href="/organization/dogs/add" class="btn btn-sun px-5 text-sm">保護犬を登録する</a>
  </header>

  <DataTable columns={["名前", "犬種", "サイズ", "譲渡状況", "おさんぽ"]} rowCount={dogs.length} caption="登録されている保護犬の一覧" emptyMessage="まだ保護犬を登録していません。" emptyActionHref="/organization/dogs/add" emptyActionLabel="保護犬を登録する">
    {
      dogs.map((dog) => (
        <tr>
          <td>
            <a href={`/organization/dogs/${dog.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {dog.name}
            </a>
          </td>
          <td>{dog.breed ?? "—"}</td>
          <td>{dogSizeLabel(dog.size)}</td>
          <td>
            <span class="badge badge-quiet">{adoptionStatusLabel(dog.adoptionStatus)}</span>
          </td>
          <td>{dog.walkEligible === 1 ? "可" : "不可"}</td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

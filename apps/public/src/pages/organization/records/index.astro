---
// ADM-13 お散歩実施記録一覧 — PRD-04 §3-2
// TODO(ADM-13): replace mockWalkRecords with listOwnWalkRecords() — F-10-01.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockWalkRecords } from "$lib/mocks";
import type { WalkRecordSummary } from "$lib/view-models/walk-record";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const records: WalkRecordSummary[] = mockWalkRecords;
---

<Layout title="実施記録">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">実施記録</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">お散歩</th>
          <th class="py-2">実施日</th>
          <th class="py-2">実施</th>
          <th class="py-2">事故報告</th>
        </tr>
      </thead>
      <tbody>
        {
          records.map((record) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/organization/records/${record.id}`}>{record.walkSlot.title}</a>
              </td>
              <td class="py-2">{record.conductedAt}</td>
              <td class="py-2">{record.conducted ? "実施" : "中止"}</td>
              <td class="py-2">{record.incidentFlag ? "あり" : "なし"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

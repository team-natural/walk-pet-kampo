---
// ADM-14 — PRD-04 §3-2 (guarded)
// TODO(ADM-14): replace mockWalkRecordDetail with getOwnWalkRecord() and post updateWalkRecord()
// — F-10-01.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockWalkRecordDetail } from "$lib/mocks";
import type { WalkRecordDetail } from "$lib/view-models/walk-record";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;
const record: WalkRecordDetail = mockWalkRecordDetail;
---

<OrganizationLayout title="実施記録の登録 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="grid gap-2" data-public-id={publicId}>
    <a href="/organization/records" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 実施記録</a>
    <h1 class="text-xl font-bold">{record.walkSlot.title}</h1>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action={`/api/v1/organization/walk-records/${record.id}`} enctype="multipart/form-data">
    <FormSection legend="実施の結果">
      <label class="flex items-center gap-3">
        <input type="checkbox" name="conducted" checked={record.conducted === 1} class="size-5 accent-brand-blossom-deep" />
        <span>実施した</span>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">いっしょに歩いた子</span>
        <input type="text" name="dogsWalked" value={record.dogsWalked} class="field w-full" />
      </label>
    </FormSection>

    <FormSection legend="当日の様子" description="参加者のマイページに表示されます。">
      <label class="grid gap-1.5">
        <span class="sr-only">当日の様子</span>
        <textarea name="staffComment" rows="5" class="field w-full rounded-2xl">{record.staffComment}</textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">写真</span>
        <input type="file" name="photos" accept="image/*" multiple class="field w-full" />
      </label>
    </FormSection>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">保存する</button>
  </form>

  <p class="max-w-2xl text-sm text-pretty text-brand-ink-soft">
    事故やトラブルがあった場合は、あわせて
    <a href="/organization/incidents/add" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">報告</a>
    をお願いします。
  </p>
</OrganizationLayout>

---
// ADM-00 — PRD-04 §3-2
// A separate screen from the Walker login (SCR-11): different table, different cookie, different
// code path (DEV-02 §1-4). Issuing the session is blocked on GOV-01 D-021.
// Chrome is forced on: everything else under /organization/ is the console shell, but someone who
// cannot sign in yet needs the public site's way back out.
// TODO(ADM-00): post to the organization login endpoint once scoped lockout keys land (F-01-03).
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
---

<Layout title="団体ログイン | 保護犬おさんぽマッチング" chrome={true}>
  <main id="main-content" class="mx-auto grid max-w-md gap-6 px-4 py-16">
    <PageHeader title="団体ログイン" lead="保護団体のスタッフの方はこちらからログインしてください。" />

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action="/api/v1/organization/auth/login">
      <label class="grid gap-1.5">
        <span class="font-bold">メールアドレス</span>
        <input type="email" name="email" required autocomplete="username" spellcheck="false" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">パスワード</span>
        <input type="password" name="password" required autocomplete="current-password" class="field w-full" />
      </label>

      <button type="submit" class="btn btn-sun px-6 py-3">ログイン</button>
    </form>

    <div class="grid gap-2 text-sm">
      <a href="/organization/forgot-password" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">パスワードをお忘れの方</a>
      <p class="text-brand-ink-soft">
        掲載をご検討の団体は
        <a href="/organization/apply" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">登録申請</a>
        から。
      </p>
    </div>
  </main>
</Layout>

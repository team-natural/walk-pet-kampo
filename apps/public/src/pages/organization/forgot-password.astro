---
// ADM-24 — PRD-04 §3-2
// The token goes in organization_member_password_reset_tokens, a different table from the
// Walker's (GOV-01 D-020).
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";

// The same confirmation whether or not the address is registered — the form must not reveal who
// has an account (DEV-02 §1-3).
const sent = Astro.url.searchParams.get("status") === "sent";
const expiredLink = Astro.url.searchParams.get("error") === "token";
---

<Layout title="パスワードの再設定 | 保護犬おさんぽマッチング" chrome={true}>
  <main id="main-content" class="mx-auto grid max-w-md gap-6 px-4 py-16">
    <PageHeader title="パスワードの再設定" lead="ご登録のメールアドレスに、再設定用のリンクをお送りします。" backHref="/organization/login" backLabel="団体ログイン" />

    {
      expiredLink && (
        <p role="alert" class="rounded-2xl border-2 border-brand-sun/70 bg-brand-sun/25 px-4 py-3 text-sm font-bold">
          再設定用リンクの有効期限が切れています。もう一度お送りします。
        </p>
      )
    }
    {
      sent && (
        <p role="status" class="rounded-2xl border-2 border-brand-blossom/60 bg-brand-blossom/20 px-4 py-3 text-sm font-bold">
          ご登録のメールアドレス宛に再設定用のリンクをお送りしました。60 分以内にお手続きください。
        </p>
      )
    }

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action="/api/v1/organization/auth/password/forgot">
      <label class="grid gap-1.5">
        <span class="font-bold">メールアドレス</span>
        <input type="email" name="email" required autocomplete="username" spellcheck="false" class="field w-full" />
      </label>
      <button type="submit" class="btn btn-sun px-6 py-3">再設定メールを送る</button>
    </form>
  </main>
</Layout>

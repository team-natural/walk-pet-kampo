---
// ADM-24 団体パスワード再設定申請 — PRD-04 §3-2
// The token goes in organization_member_password_reset_tokens, a different table from the
// Walker's (GOV-01 D-020).
// TODO(ADM-24): post to requestOrganizationMemberPasswordReset() — F-01-04 相当.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="パスワードの再設定">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center gap-6 p-6">
    <h1 class="text-2xl font-bold">パスワードの再設定</h1>
    <p class="text-sm text-gray-600">ご登録のメールアドレスに再設定用のリンクをお送りします。</p>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/organization/auth/forgot-password">
      <label class="grid gap-1">
        <span>メールアドレス</span>
        <input type="email" name="email" required class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">再設定メールを送る</button>
    </form>
  </main>
</Layout>

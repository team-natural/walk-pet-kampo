---
// ADM-17 — PRD-04 §3-2 (guarded)
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { incidentCategoryLabel, incidentStatusLabel } from "$lib/incident-status";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { listOwnIncidents } from "$lib/server/services/incidents";
import type { IncidentSummary } from "$lib/view-models/incident";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const incidents: IncidentSummary[] = await listOwnIncidents(db, session.organizationId);

const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="事故・トラブル | 団体ページ" session={session}>
  <FlashMessage />

  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-bold">事故・トラブル</h1>
    <a href="/organization/incidents/add" class="btn btn-sun px-5 text-sm">報告する</a>
  </header>

  <DataTable columns={["発生日時", "重大度", "種別", "状態"]} rowCount={incidents.length} caption="報告された事故・トラブルの一覧" emptyMessage="報告された事故・トラブルはありません。" emptyActionHref="/organization/incidents/add" emptyActionLabel="報告する">
    {
      incidents.map((incident) => (
        <tr>
          <td class="tabular-nums">
            <a href={`/organization/incidents/${incident.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {dateFormat.format(new Date(incident.occurredAt))}
            </a>
          </td>
          <td>
            <span class="badge badge-blossom">{incident.severity}</span>
          </td>
          <td>{incidentCategoryLabel(incident.category)}</td>
          <td>
            <span class="badge badge-quiet">{incidentStatusLabel(incident.status)}</span>
          </td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

---
// ADM-17 事故・トラブル報告一覧 — PRD-04 §3-2
// TODO(ADM-17): replace mockIncidents with listOwnIncidents() — F-12-01.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockIncidents } from "$lib/mocks";
import type { IncidentSummary } from "$lib/view-models/incident";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const incidents: IncidentSummary[] = mockIncidents;
---

<Layout title="事故・トラブル報告">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold">事故・トラブル報告</h1>
      <a href="/organization/incidents/add" class="text-sm underline">報告する</a>
    </header>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">発生日時</th>
          <th class="py-2">重大度</th>
          <th class="py-2">種別</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          incidents.map((incident) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/organization/incidents/${incident.id}`}>{incident.occurredAt}</a>
              </td>
              <td class="py-2">{incident.severity}</td>
              <td class="py-2">{incident.category}</td>
              <td class="py-2">{incident.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

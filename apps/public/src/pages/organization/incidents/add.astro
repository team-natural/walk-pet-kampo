---
// ADM-18 — PRD-04 §3-2 (guarded)
// A high severity report reaches the operator immediately, and the form says so before the
// submit rather than after (PRD-03 F-12-02).
// TODO(ADM-18): post to createIncident() — F-12-01.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
---

<OrganizationLayout title="事故・トラブルの報告 | 団体ページ" session={session}>
  <header class="grid gap-2">
    <a href="/organization/incidents" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 事故・トラブル</a>
    <h1 class="text-xl font-bold">事故・トラブルの報告</h1>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action="/api/v1/organization/incidents" enctype="multipart/form-data">
    <FormSection legend="発生した内容">
      <label class="grid gap-1.5">
        <span class="font-bold">重大度</span>
        <select name="severity" class="field w-full">
          <option value="P0">P0（重大・即時対応）</option>
          <option value="P1">P1</option>
          <option value="P2" selected>P2</option>
          <option value="P3">P3</option>
        </select>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">種別</span>
        <select name="category" class="field w-full">
          <option value="bite">咬傷</option>
          <option value="escape">脱走</option>
          <option value="injury">怪我</option>
          <option value="dog_condition">犬の体調</option>
          <option value="walker_condition">参加者の体調</option>
          <option value="property_damage">物損</option>
          <option value="other">その他</option>
        </select>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">発生日時</span>
        <input type="datetime-local" name="occurredAt" required class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">場所</span>
        <input type="text" name="location" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">状況</span>
        <textarea name="description" rows="6" required class="field w-full rounded-2xl"></textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">添付</span>
        <input type="file" name="attachments" multiple class="field w-full" />
      </label>
    </FormSection>

    <p class="rounded-2xl border-2 border-brand-sun/70 bg-brand-sun/20 px-4 py-3 text-sm font-bold text-pretty">重大度の高い報告は、送信と同時に運営へ共有されます。</p>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">報告する</button>
  </form>
</OrganizationLayout>

---
// ADM-16 — PRD-04 §3-2 (guarded, org_admin only)
// TODO(ADM-16): replace mockPayoutDetail with getOwnPayout() — F-09-02.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { mockPayoutDetail } from "$lib/mocks";
import { formatYen } from "$lib/pricing";
import type { PayoutDetail } from "$lib/view-models/payout";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const { publicId } = Astro.params;
const payout: PayoutDetail = mockPayoutDetail;
---

<OrganizationLayout title="還元の明細 | 団体ページ" session={session}>
  <header class="grid gap-2" data-public-id={publicId}>
    <a href="/organization/payouts" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 還元・振込</a>
    <h1 class="text-xl font-bold tabular-nums">{payout.periodStart} 〜 {payout.periodEnd}</h1>
    <p><span class="badge badge-quiet">{payout.status}</span></p>
  </header>

  <div class="card max-w-2xl p-6 sm:p-8">
    <dl class="detail-list">
      <div>
        <dt>対象予約</dt>
        <dd class="tabular-nums">{payout.totalReservations} 件 / {payout.totalParticipants} 名</dd>
      </div>
      <div>
        <dt>還元対象額</dt>
        <dd class="whitespace-nowrap tabular-nums">{formatYen(payout.grossAmount)}</dd>
      </div>
      <div>
        <dt>調整額</dt>
        <dd class="whitespace-nowrap tabular-nums">{formatYen(payout.adjustmentAmount)}</dd>
      </div>
      <div>
        <dt>振込額</dt>
        <dd class="text-xl font-bold whitespace-nowrap tabular-nums">{formatYen(payout.payoutAmount)}</dd>
      </div>
      <div>
        <dt>振込予定</dt>
        <dd class="tabular-nums">{payout.scheduledAt ?? "—"}</dd>
      </div>
      <div>
        <dt>備考</dt>
        <dd class="text-pretty">{payout.notes ?? "—"}</dd>
      </div>
    </dl>
  </div>

  <p class="max-w-2xl text-sm text-pretty text-brand-ink-soft">金額に相違がある場合は、お問い合わせからご連絡ください。振込の実行は運営が行います。</p>
</OrganizationLayout>

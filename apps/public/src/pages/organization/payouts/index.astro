---
// ADM-15 — PRD-04 §3-2 (guarded, org_admin only)
// TODO(ADM-15): replace mockPayouts with listOwnPayouts() — F-09-02, F-09-04.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import StatCard from "$lib/components/organization/stat-card.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { mockPayouts } from "$lib/mocks";
import { formatYen } from "$lib/pricing";
import type { PayoutSummary } from "$lib/view-models/payout";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const payouts: PayoutSummary[] = mockPayouts;
const totalPaid = payouts.filter((payout) => payout.status === "paid").reduce((sum, payout) => sum + payout.payoutAmount, 0);
const pending = payouts.filter((payout) => payout.status !== "paid").reduce((sum, payout) => sum + payout.payoutAmount, 0);
---

<OrganizationLayout title="還元・振込 | 団体ページ" session={session}>
  <h1 class="text-xl font-bold">還元・振込</h1>

  <div class="grid gap-4 sm:grid-cols-2">
    <StatCard label="これまでの振込額" value={formatYen(totalPaid)} />
    <StatCard label="振込予定額" value={formatYen(pending)} />
  </div>

  <DataTable columns={["対象期間", "還元額", "状態", "振込日"]} rowCount={payouts.length} caption="団体還元・振込の履歴" emptyMessage="まだ還元の記録はありません。おさんぽが実施されると集計されます。" emptyActionHref="/organization/walks" emptyActionLabel="おさんぽ募集を見る">
    {
      payouts.map((payout) => (
        <tr>
          <td class="tabular-nums">
            <a href={`/organization/payouts/${payout.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {payout.periodStart} 〜 {payout.periodEnd}
            </a>
          </td>
          <td class="whitespace-nowrap tabular-nums">{formatYen(payout.payoutAmount)}</td>
          <td>
            <span class="badge badge-quiet">{payout.status}</span>
          </td>
          <td class="tabular-nums">{payout.paidAt ?? "—"}</td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

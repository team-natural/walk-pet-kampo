---
// ADM-26 — PRD-04 §3-2
// The receiving end of ADM-04. The invitee has no account yet, so the invitations token is what
// establishes who this is — there is no session guard here on purpose.
// TODO(ADM-26): resolve the token with getInvitationByToken() and post acceptInvitation()
// — F-03-06, F-04-03.
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";

const { token } = Astro.params;
---

<Layout title="アカウントの有効化 | 保護犬おさんぽマッチング" chrome={true}>
  <main id="main-content" class="mx-auto grid max-w-md gap-6 px-4 py-16">
    <PageHeader title="アカウントの有効化" lead="パスワードを設定すると、団体ページにログインできるようになります。" />

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action="/api/v1/organization/invitations/accept">
      <input type="hidden" name="token" value={token} />

      <label class="grid gap-1.5">
        <span class="font-bold">お名前</span>
        <input type="text" name="name" required autocomplete="name" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">パスワード</span>
        <input type="password" name="password" required autocomplete="new-password" class="field w-full" />
      </label>

      <button type="submit" class="btn btn-sun px-6 py-3">設定して開始する</button>
    </form>
  </main>
</Layout>

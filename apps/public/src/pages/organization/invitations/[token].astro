---
// ADM-26 — PRD-04 §3-2
// The receiving end of ADM-04. The invitee has no account yet, so the invitations token is what
// establishes who this is — there is no session guard here on purpose.
// TODO(ADM-26): resolve the token with getInvitationByToken() and post acceptInvitation()
// — F-03-06, F-04-03.
import Layout from "../../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="招待の受諾">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center gap-6 p-6">
    <h1 class="text-2xl font-bold">アカウントの有効化</h1>
    <p class="text-sm text-gray-600">パスワードを設定すると、団体ページにログインできるようになります。</p>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/organization/invitations/accept">
      <input type="hidden" name="token" value={token} />
      <label class="grid gap-1">
        <span>お名前</span>
        <input type="text" name="name" required class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>パスワード</span>
        <input type="password" name="password" required class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">設定して開始する</button>
    </form>
  </main>
</Layout>

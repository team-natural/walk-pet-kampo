---
// ADM-04 — PRD-04 §3-2 (guarded, org_admin only)
// Sends an invitation; the invitee sets their own password on ADM-26. No password is entered here.
// TODO(ADM-04): post to createInvitation() — F-04-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);
---

<OrganizationLayout title="スタッフの招待 | 団体ページ" session={session}>
  <header class="grid gap-2">
    <a href="/organization/members" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← スタッフ</a>
    <h1 class="text-xl font-bold">スタッフの招待</h1>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action="/api/v1/organization/members/invite">
    <FormSection legend="招待する相手" description="招待メールのリンクから、ご本人がパスワードを設定します。">
      <label class="grid gap-1.5">
        <span class="font-bold">メールアドレス</span>
        <input type="email" name="email" required autocomplete="off" spellcheck="false" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">権限</span>
        <select name="role" class="field w-full">
          <option value="org_staff">スタッフ（保護犬・おさんぽ枠・予約の管理）</option>
          <option value="org_admin">管理者（団体情報・スタッフ・還元の管理を含む）</option>
        </select>
      </label>
    </FormSection>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">招待メールを送る</button>
  </form>
</OrganizationLayout>

---
// ADM-03 団体スタッフ一覧 — PRD-04 §3-2（org_admin のみ）
// TODO(ADM-03): replace mockOrganizationMembers with listOrganizationMembers() — F-04-03.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { mockOrganizationMembers } from "$lib/mocks";
import type { OrganizationMemberView } from "$lib/view-models/organization-member";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const members: OrganizationMemberView[] = mockOrganizationMembers;
---

<Layout title="スタッフ一覧">
  <main class="mx-auto flex min-h-dvh max-w-4xl flex-col gap-6 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold">スタッフ</h1>
      <a href="/organization/members/add" class="text-sm underline">スタッフを招待する</a>
    </header>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">氏名</th>
          <th class="py-2">メールアドレス</th>
          <th class="py-2">権限</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          members.map((member) => (
            <tr class="border-b">
              <td class="py-2">{member.name}</td>
              <td class="py-2">{member.email}</td>
              <td class="py-2">{member.role}</td>
              <td class="py-2">{member.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

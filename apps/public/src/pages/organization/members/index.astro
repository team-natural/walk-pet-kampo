---
// ADM-03 — PRD-04 §3-2 (guarded, org_admin only)
// TODO(ADM-03): replace mockOrganizationMembers with listOrganizationMembers() — F-04-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { mockOrganizationMembers } from "$lib/mocks";
import type { OrganizationMemberView } from "$lib/view-models/organization-member";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const members: OrganizationMemberView[] = mockOrganizationMembers;
---

<OrganizationLayout title="スタッフ | 団体ページ" session={session}>
  <FlashMessage />

  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-bold">スタッフ</h1>
    <a href="/organization/members/add" class="btn btn-sun px-5 text-sm">スタッフを招待する</a>
  </header>

  <DataTable columns={["氏名", "メールアドレス", "権限", "状態"]} rowCount={members.length} caption="この団体のスタッフ一覧" emptyMessage="まだスタッフがいません。" emptyActionHref="/organization/members/add" emptyActionLabel="スタッフを招待する">
    {
      members.map((member) => (
        <tr>
          <td class="font-bold">{member.name}</td>
          <td>{member.email}</td>
          <td>{member.role === "org_admin" ? "管理者" : "スタッフ"}</td>
          <td>
            <span class="badge badge-quiet">{member.status}</span>
          </td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

---
// SCR-51 — PRD-04 §3-1
// The applicant has no account yet, so the URL token in organization_application_tokens is what
// establishes who this is (GOV-01 D-020). There is no session guard here on purpose.
// TODO(SCR-51): resolve the token with getApplicationByToken() and post the resubmission — F-03-05.
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { mockOrganizationApplicationStatus } from "$lib/mocks";
import type { OrganizationApplicationStatus } from "$lib/view-models/organization";

const { token } = Astro.params;
const organization: OrganizationApplicationStatus = mockOrganizationApplicationStatus;
---

<Layout title="申請状況の確認 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-2xl gap-6 px-4 py-12">
    <PageHeader title="申請状況の確認" lead="追加の確認をお願いしています。以下の内容をご記入のうえ、再提出してください。">
      <p class="flex flex-wrap items-center gap-3 text-sm">
        <span class="font-bold">{organization.name}</span>
        <span class="badge">{organization.status}</span>
      </p>
    </PageHeader>

    {
      organization.rejectionReason && (
        <div class="card grid gap-2 border-2 border-brand-sun/60 p-6 text-sm">
          <p class="font-bold">運営からの確認事項</p>
          <p class="text-pretty text-brand-ink-soft">{organization.rejectionReason}</p>
        </div>
      )
    }

    <form class="card grid gap-4 p-6 text-sm sm:p-8" method="post" action="/api/v1/organization/resubmit" enctype="multipart/form-data">
      <input type="hidden" name="token" value={token} />

      <label class="grid gap-1.5">
        <span class="font-bold">追加のご説明</span>
        <textarea name="note" rows="5" class="field w-full rounded-2xl"></textarea>
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">追加書類</span>
        <input type="file" name="documents" multiple class="field w-full" />
      </label>

      <button type="submit" class="btn btn-sun px-6 py-3">再提出する</button>
    </form>
  </main>
</Layout>

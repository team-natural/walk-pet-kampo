---
// SCR-16 — PRD-04 §3-1
// Doubles as the confirmation for a resubmission (SCR-51): both end the same way — the applicant
// waits for the operator, with nothing more to do.
import Layout from "../../../layouts/Layout.astro";
import CompletionPanel from "$lib/components/completion-panel.astro";

const resubmitted = Astro.url.searchParams.get("status") === "resubmitted";
---

<Layout title={resubmitted ? "再提出を受け付けました | 保護犬おさんぽマッチング" : "申請を受け付けました | 保護犬おさんぽマッチング"}>
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16">
    {resubmitted ? <CompletionPanel title="再提出を受け付けました" message="いただいた内容をもとに、運営があらためて審査します。結果はご登録のメールアドレスにご連絡します。" actionHref="/" actionLabel="トップページへ" /> : <CompletionPanel title="申請を受け付けました" message="審査の結果はご登録のメールアドレスにご連絡します。追加の確認が必要な場合は、メールのリンクから再提出いただきます。" actionHref="/" actionLabel="トップページへ" />}
  </main>
</Layout>

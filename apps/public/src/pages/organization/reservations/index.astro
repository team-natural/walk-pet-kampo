---
// ADM-11 — PRD-04 §3-2 (guarded)
// TODO(ADM-11): replace mockReservations with listOwnReservations() — F-06-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import DataTable from "$lib/components/organization/data-table.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockReservations } from "$lib/mocks";
import type { ReservationSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const reservations: ReservationSummary[] = mockReservations;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="予約 | 団体ページ" session={session}>
  <FlashMessage />

  <h1 class="text-xl font-bold">予約</h1>

  <DataTable columns={["おさんぽ", "開催", "人数", "状態"]} rowCount={reservations.length} caption="受け付けている予約の一覧" emptyMessage="まだ予約はありません。" emptyActionHref="/organization/walks" emptyActionLabel="おさんぽ募集を見る">
    {
      reservations.map((reservation) => (
        <tr>
          <td>
            <a href={`/organization/reservations/${reservation.id}`} class="rounded font-bold underline-offset-4 hover:underline">
              {reservation.walkSlot.title}
            </a>
          </td>
          <td class="tabular-nums">{dateFormat.format(new Date(reservation.walkSlot.startAt))}</td>
          <td class="tabular-nums">{reservation.participantCount}</td>
          <td>
            <span class="badge badge-quiet">{reservation.status}</span>
          </td>
        </tr>
      ))
    }
  </DataTable>
</OrganizationLayout>

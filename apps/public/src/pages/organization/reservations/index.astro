---
// ADM-11 予約一覧 — PRD-04 §3-2
// TODO(ADM-11): replace mockReservations with listOwnReservations() — F-06-03.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockReservations } from "$lib/mocks";
import type { ReservationSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const reservations: ReservationSummary[] = mockReservations;
---

<Layout title="予約">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">予約</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">お散歩</th>
          <th class="py-2">開催</th>
          <th class="py-2">人数</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          reservations.map((reservation) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/organization/reservations/${reservation.id}`}>{reservation.walkSlot.title}</a>
              </td>
              <td class="py-2">{reservation.walkSlot.startAt}</td>
              <td class="py-2">{reservation.participantCount}</td>
              <td class="py-2">{reservation.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

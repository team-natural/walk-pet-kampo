---
// ADM-12 予約詳細 — PRD-04 §3-2
// The emergency contact is disclosed to the walk's staff only once the reservation is confirmed
// (DEV-02 §8-1), so the Service filters it rather than the template hiding it.
// TODO(ADM-12): replace mockReservationDetail with getOwnReservation() — F-06-03.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;
const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="予約の詳細">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6" data-public-id={publicId}>
    <h1 class="text-2xl font-bold">{reservation.walkSlot.title}</h1>

    <dl class="grid gap-1 text-sm">
      <div><dt class="inline text-gray-500">開催</dt> <dd class="inline">{reservation.walkSlot.startAt}</dd></div>
      <div><dt class="inline text-gray-500">人数</dt> <dd class="inline">{reservation.participantCount} 名</dd></div>
      <div><dt class="inline text-gray-500">状態</dt> <dd class="inline">{reservation.status}</dd></div>
      <div><dt class="inline text-gray-500">緊急連絡先</dt> <dd class="inline">{reservation.emergencyContactNameSnapshot}（{reservation.emergencyContactPhoneSnapshot}）</dd></div>
    </dl>
  </main>
</Layout>

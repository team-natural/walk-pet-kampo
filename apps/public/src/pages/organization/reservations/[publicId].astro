---
// ADM-12 — PRD-04 §3-2 (guarded)
// The emergency contact is disclosed to the walk's staff only once the reservation is confirmed
// (DEV-02 §8-1), so the Service filters it rather than the template hiding it.
// TODO(ADM-12): replace mockReservationDetail with getOwnReservation() — F-06-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../../layouts/OrganizationLayout.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const { publicId } = Astro.params;
const reservation: ReservationDetail = mockReservationDetail;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "long", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="予約の詳細 | 団体ページ" session={session}>
  <header class="grid gap-2" data-public-id={publicId}>
    <a href="/organization/reservations" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 予約</a>
    <h1 class="text-xl font-bold">{reservation.walkSlot.title}</h1>
    <p><span class="badge badge-quiet">{reservation.status}</span></p>
  </header>

  <div class="card max-w-2xl p-6 sm:p-8">
    <dl class="detail-list">
      <div>
        <dt>開催</dt>
        <dd>{dateFormat.format(new Date(reservation.walkSlot.startAt))}</dd>
      </div>
      <div>
        <dt>参加人数</dt>
        <dd class="tabular-nums">{reservation.participantCount} 名</dd>
      </div>
      <div>
        <dt>緊急連絡先</dt>
        <dd>{reservation.emergencyContactNameSnapshot}（{reservation.emergencyContactPhoneSnapshot}）</dd>
      </div>
      <div>
        <dt>決済</dt>
        <dd>{reservation.payment?.status}</dd>
      </div>
    </dl>
  </div>

  <p class="max-w-2xl text-sm text-pretty text-brand-ink-soft">緊急連絡先は当日の安全管理のためにのみ利用してください。参加者のキャンセルは参加者自身、または運営が行います。</p>
</OrganizationLayout>

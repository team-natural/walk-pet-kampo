---
// ADM-02 — PRD-04 §3-2 (guarded, org_admin only)
// TODO(ADM-02): replace mockOrganizationDetail with getOwnOrganization() and post
// updateOrganization() — F-04-01, F-04-02.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { mockOrganizationDetail } from "$lib/mocks";
import type { OrganizationDetail } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const organization: OrganizationDetail = mockOrganizationDetail;
---

<Layout title="団体情報の編集">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">団体情報の編集</h1>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/organization/profile">
      <label class="grid gap-1">
        <span>団体名</span>
        <input type="text" name="name" value={organization.name} class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>代表者名</span>
        <input type="text" name="representativeName" value={organization.representativeName} class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>活動エリア</span>
        <input type="text" name="activityArea" value={organization.activityArea} class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <label class="grid gap-1">
        <span>住所の公開範囲</span>
        <select name="addressVisibility" class="rounded border border-gray-300 px-3 py-2">
          <option value="prefecture_only" selected={organization.addressVisibility === "prefecture_only"}>都道府県まで</option>
          <option value="city_only" selected={organization.addressVisibility === "city_only"}>市区町村まで</option>
          <option value="reservation_confirmed_only" selected={organization.addressVisibility === "reservation_confirmed_only"}>予約確定者のみ</option>
        </select>
      </label>
      <label class="grid gap-1">
        <span>団体紹介</span>
        <textarea name="introduction" rows="6" class="rounded border border-gray-300 px-3 py-2">{organization.introduction}</textarea>
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">保存する</button>
    </form>
  </main>
</Layout>

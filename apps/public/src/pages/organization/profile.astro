---
// ADM-02 — PRD-04 §3-2 (guarded, org_admin only)
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession, isOrganizationAdmin } from "$lib/server/auth/organization-session";
import { getOwnOrganization } from "$lib/server/services/organization-profile";
import type { OrganizationDetail } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);
if (!isOrganizationAdmin(session)) return Astro.redirect("/organization", 302);

const organization: OrganizationDetail = await getOwnOrganization(db, session.organizationId);
---

<OrganizationLayout title="団体情報 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="grid gap-2">
    <h1 class="text-xl font-bold">団体情報</h1>
    <p class="text-sm">
      <a href={`/organizations/${organization.slug}`} class="rounded text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">公開ページを見る</a>
    </p>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action="/api/v1/organization/profile">
    <FormSection legend="基本情報">
      <label class="grid gap-1.5">
        <span class="font-bold">団体名</span>
        <input type="text" name="name" value={organization.name} class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">代表者名</span>
        <input type="text" name="representativeName" value={organization.representativeName} class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">活動エリア</span>
        <input type="text" name="activityArea" value={organization.activityArea} class="field w-full" />
      </label>
    </FormSection>

    <FormSection legend="公開範囲" description="所在地をどこまで公開するかを選べます。">
      <label class="grid gap-1.5">
        <span class="font-bold">所在地</span>
        <input type="text" name="address" value={organization.address} autocomplete="street-address" class="field w-full" />
      </label>

      <label class="grid gap-1.5">
        <span class="font-bold">住所の公開範囲</span>
        <select name="addressVisibility" class="field w-full">
          <option value="prefecture_only" selected={organization.addressVisibility === "prefecture_only"}>都道府県まで</option>
          <option value="city_only" selected={organization.addressVisibility === "city_only"}>市区町村まで</option>
          <option value="reservation_confirmed_only" selected={organization.addressVisibility === "reservation_confirmed_only"}>予約確定者のみ</option>
        </select>
      </label>
    </FormSection>

    <FormSection legend="団体紹介" description="公開ページに表示されます。">
      <label class="grid gap-1.5">
        <span class="sr-only">団体紹介</span>
        <textarea name="introduction" rows="6" class="field w-full rounded-2xl">{organization.introduction}</textarea>
      </label>
    </FormSection>

    <button type="submit" class="btn btn-sun w-fit px-6 py-3">保存する</button>
  </form>
</OrganizationLayout>

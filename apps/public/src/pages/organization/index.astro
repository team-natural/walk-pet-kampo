---
// ADM-01 — PRD-04 §3-2 (guarded)
// Reference skeleton for an ORGANIZATION screen: guarded, and the guard redirects rather than
// answering 401 because this is a page, not an API route (DEV-01 §5).
// TODO(ADM-01): replace mockOrganizationDashboard with getOrganizationDashboard() — F-15-01.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import StatCard from "$lib/components/organization/stat-card.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockOrganizationDashboard } from "$lib/mocks";
import type { OrganizationDashboardView } from "$lib/view-models/dashboard";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const dashboard: OrganizationDashboardView = mockOrganizationDashboard;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<OrganizationLayout title="ダッシュボード | 団体ページ" session={session}>
  <FlashMessage />

  <h1 class="text-xl font-bold">ダッシュボード</h1>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {dashboard.tiles.map((tile) => <StatCard label={tile.label} value={tile.value} href={tile.href} />)}
  </div>

  <section class="grid gap-3">
    <h2 class="font-bold">直近のおさんぽ</h2>
    <ul class="grid gap-3">
      {
        dashboard.upcomingWalks.map((walk) => (
          <li class="card flex flex-wrap items-center justify-between gap-3 p-5 text-sm">
            <div>
              <a href={`/organization/walks/${walk.id}`} class="rounded font-bold underline-offset-4 hover:underline">
                {walk.title}
              </a>
              <p class="text-brand-ink-soft tabular-nums">{dateFormat.format(new Date(walk.startAt))}</p>
            </div>
            <span class="badge badge-blossom tabular-nums">
              {walk.reservedCount} / {walk.capacity} 名
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="grid gap-3">
    <h2 class="font-bold">直近の予約</h2>
    <ul class="grid gap-3">
      {
        dashboard.recentReservations.map((reservation) => (
          <li class="card flex flex-wrap items-center justify-between gap-3 p-5 text-sm">
            <div>
              <a href={`/organization/reservations/${reservation.id}`} class="rounded font-bold underline-offset-4 hover:underline">
                {reservation.walkSlotTitle}
              </a>
              <p class="text-brand-ink-soft">{reservation.walkerName}</p>
            </div>
            <span class="badge badge-quiet">{reservation.status}</span>
          </li>
        ))
      }
    </ul>
  </section>
</OrganizationLayout>

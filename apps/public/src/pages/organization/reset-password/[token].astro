---
// ADM-25 団体パスワード再設定 — PRD-04 §3-2
// TODO(ADM-25): validate the token and post resetOrganizationMemberPassword() — F-01-04 相当.
import Layout from "../../../layouts/Layout.astro";

const { token } = Astro.params;
---

<Layout title="新しいパスワードの設定">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center gap-6 p-6">
    <h1 class="text-2xl font-bold">新しいパスワードの設定</h1>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/organization/auth/password/reset">
      <input type="hidden" name="token" value={token} />
      <label class="grid gap-1">
        <span>新しいパスワード</span>
        <input type="password" name="password" required class="rounded border border-gray-300 px-3 py-2" />
      </label>
      <button type="submit" class="rounded border border-gray-300 px-3 py-2">設定する</button>
    </form>
  </main>
</Layout>

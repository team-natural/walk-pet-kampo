---
// ADM-27 — PRD-04 §3-2 (guarded)
// notification_settings is shared with Walker (DEV-07 §5-18), so the Service scopes the rows by
// account system — this screen never filters them itself.
// TODO(ADM-27): replace mockNotificationSettings with getNotificationSettings() and post
// updateNotificationSettings() — F-13-03.
import { env } from "cloudflare:workers";
import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import FlashMessage from "$lib/components/organization/flash-message.astro";
import FormSection from "$lib/components/organization/form-section.astro";
import { getOrganizationSession } from "$lib/server/auth/organization-session";
import { mockNotificationSettings } from "$lib/mocks";
import type { NotificationSettingView } from "$lib/view-models/notification";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getOrganizationSession(Astro.cookies, db);
if (!session) return Astro.redirect("/organization/login", 302);

const settings: NotificationSettingView[] = mockNotificationSettings;
---

<OrganizationLayout title="通知設定 | 団体ページ" session={session}>
  <FlashMessage />

  <header class="grid gap-2">
    <a href="/organization/notifications" class="w-fit rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">← 通知</a>
    <h1 class="text-xl font-bold">通知設定</h1>
  </header>

  <form class="grid max-w-2xl gap-4" method="post" action="/api/v1/organization/notification-settings">
    {
      settings.map((setting) => (
        <FormSection legend={setting.type}>
          <label class="flex items-center gap-3">
            <input type="checkbox" name={`${setting.type}.email`} checked={setting.emailEnabled} class="size-5 accent-brand-blossom-deep" />
            <span>メールで受け取る</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name={`${setting.type}.inApp`} checked={setting.inAppEnabled} class="size-5 accent-brand-blossom-deep" />
            <span>サイト内で受け取る</span>
          </label>
        </FormSection>
      ))
    }
    <button type="submit" class="btn btn-sun w-fit px-6 py-3">保存する</button>
  </form>
</OrganizationLayout>

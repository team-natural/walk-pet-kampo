---
// SCR-10 — PRD-04 §3-1
// TODO(SCR-10): verify the token with consumeEmailVerificationToken() and show the outcome — F-01-01.
import Layout from "../../../layouts/Layout.astro";
import CompletionPanel from "$lib/components/completion-panel.astro";

const { token } = Astro.params;
---

<Layout title="メールアドレスを確認しました | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-16" data-token={token}>
    <CompletionPanel title="メールアドレスを確認しました" message="ご登録が完了しました。ログインすると、おさんぽの予約ができるようになります。" actionHref="/auth/login" actionLabel="ログインする" />
  </main>
</Layout>

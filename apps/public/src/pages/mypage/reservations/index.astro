---
// SCR-24 — PRD-04 §3-1 (guarded)
// TODO(SCR-24): replace mockReservations with listWalkerReservations() — F-08-07.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservations } from "$lib/mocks";
import type { ReservationSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservations: ReservationSummary[] = mockReservations;

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<Layout title="予約履歴 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-8 px-4 py-12">
    <PageHeader title="予約履歴" backHref="/mypage" backLabel="マイページ" />

    {
      reservations.length > 0 ? (
        <ul class="grid gap-4">
          {reservations.map((reservation) => (
            <li class="card p-6">
              <p class="flex flex-wrap items-center gap-x-2 text-sm font-bold text-brand-ink-soft">
                <time datetime={reservation.walkSlot.startAt}>{dateFormat.format(new Date(reservation.walkSlot.startAt))}</time>
                <span aria-hidden="true">・</span>
                <span class="tabular-nums">{reservation.participantCount} 名</span>
              </p>
              <h2 class="mt-2 text-lg font-bold text-balance">
                <a href={`/mypage/reservations/${reservation.id}`} class="rounded underline-offset-4 hover:underline">
                  {reservation.walkSlot.title}
                </a>
              </h2>
              <p class="mt-3">
                <span class="badge badge-blossom">{reservation.status}</span>
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="まだ予約はありません。" actionHref="/walks" actionLabel="おさんぽをさがす" />
      )
    }
  </main>
</Layout>

---
// SCR-25 — PRD-04 §3-1 (guarded)
// TODO(SCR-25): replace mockReservationDetail with getWalkerReservation() and post
// cancelReservation() — F-08-03, F-08-07.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const { publicId } = Astro.params;
const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="予約の詳細">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6" data-public-id={publicId}>
    <h1 class="text-2xl font-bold">{reservation.walkSlot.title}</h1>

    <dl class="grid gap-1 text-sm">
      <div><dt class="inline text-gray-500">開催</dt> <dd class="inline">{reservation.walkSlot.startAt}</dd></div>
      <div><dt class="inline text-gray-500">人数</dt> <dd class="inline">{reservation.participantCount} 名</dd></div>
      <div><dt class="inline text-gray-500">状態</dt> <dd class="inline">{reservation.status}</dd></div>
      <div><dt class="inline text-gray-500">お支払い</dt> <dd class="inline">{reservation.payment?.amount} 円 / {reservation.payment?.status}</dd></div>
      <div><dt class="inline text-gray-500">キャンセル規定</dt> <dd class="inline">{reservation.walkSlot.title} のページをご確認ください</dd></div>
    </dl>

    <form method="post" action={`/api/v1/me/reservations/${reservation.id}/cancel`}>
      <button type="submit" class="rounded border border-red-300 px-3 py-2 text-sm text-red-700">予約をキャンセルする</button>
    </form>
  </main>
</Layout>

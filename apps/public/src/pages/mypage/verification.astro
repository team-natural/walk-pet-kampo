---
// SCR-23 — PRD-04 §3-1 (guarded)
// TODO(SCR-23): replace mockWalkerProfile with getWalkerProfile() — F-01-01, F-01-02.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { mockWalkerProfile } from "$lib/mocks";
import type { WalkerProfileView } from "$lib/view-models/walker";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const profile: WalkerProfileView = mockWalkerProfile;
---

<Layout title="本人・連絡先の確認状況 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-2xl gap-6 px-4 py-12">
    <PageHeader title="本人・連絡先の確認状況" lead="おさんぽの予約には、電話番号の確認と規約への同意が必要です。" backHref="/mypage" backLabel="マイページ" />

    <div class="card p-6 sm:p-8">
      <dl class="detail-list">
        <div>
          <dt>アカウントの状態</dt>
          <dd><span class="badge badge-blossom">{profile.status}</span></dd>
        </div>
        <div>
          <dt>電話番号の確認</dt>
          <dd>{profile.phoneVerifiedAt ? <span class="badge">確認済み</span> : <span class="badge badge-quiet">未確認</span>}</dd>
        </div>
        <div>
          <dt>規約への同意</dt>
          <dd class="tabular-nums">{profile.termsAgreedVersion ?? "未同意"}</dd>
        </div>
      </dl>
    </div>

    {
      !profile.phoneVerifiedAt && (
        <div class="card grid gap-3 p-6">
          <h2 class="font-bold">電話番号を確認する</h2>
          <p class="text-sm text-pretty text-brand-ink-soft">プロフィールに電話番号を登録すると、確認の手続きに進めます。</p>
          <a href="/mypage/profile" class="btn btn-blossom w-fit px-6">
            プロフィールを編集する
          </a>
        </div>
      )
    }
  </main>
</Layout>

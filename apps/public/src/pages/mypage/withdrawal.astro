---
// SCR-33 — PRD-04 §3-1 (guarded)
// TODO(SCR-33): post to requestWalkerWithdrawal() — F-02-06.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);
---

<Layout title="退会のお手続き">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">退会のお手続き</h1>
    <p class="text-sm text-gray-600">確定済みの予約が残っている場合は、退会の前にキャンセルのお手続きが必要です。退会後、登録情報は一定期間の後に削除されます。</p>

    <form class="grid gap-4 text-sm" method="post" action="/api/v1/me/withdrawal">
      <label class="grid gap-1">
        <span>退会の理由（任意）</span>
        <textarea name="reason" rows="4" class="rounded border border-gray-300 px-3 py-2"></textarea>
      </label>
      <label class="flex items-start gap-2">
        <input type="checkbox" name="confirmed" required />
        <span>退会すると元に戻せないことを理解しました</span>
      </label>
      <button type="submit" class="rounded border border-red-300 px-3 py-2 text-red-700">退会する</button>
    </form>
  </main>
</Layout>

---
// SCR-31 — PRD-04 §3-1 (guarded)
// TODO(SCR-31): replace mockAdoptionInquiryDetail with getWalkerAdoptionInquiry() — F-11-03.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { mockAdoptionInquiryDetail } from "$lib/mocks";
import type { AdoptionInquiryDetail } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const { publicId } = Astro.params;
const inquiry: AdoptionInquiryDetail = mockAdoptionInquiryDetail;
---

<Layout title="里親相談の詳細 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-6 px-4 py-12" data-public-id={publicId}>
    <PageHeader title={`${inquiry.dog.name} の里親相談`} backHref="/mypage/adoption-inquiries" backLabel="里親相談">
      <p><span class="badge badge-blossom">{inquiry.status}</span></p>
    </PageHeader>

    <div class="card p-6 sm:p-8">
      <dl class="detail-list">
        <div>
          <dt>相談先</dt>
          <dd>
            <a href={`/organizations/${inquiry.organization.slug}`} class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">{inquiry.organization.name}</a>
          </dd>
        </div>
        <div>
          <dt>希望理由</dt>
          <dd class="text-pretty">{inquiry.motivation}</dd>
        </div>
        <div>
          <dt>飼育環境</dt>
          <dd class="text-pretty">{inquiry.livingEnvironment}</dd>
        </div>
      </dl>
    </div>

    <p class="text-sm text-pretty text-brand-ink-soft">保護団体からの連絡はサービス外で直接行われます。しばらく連絡がない場合は、団体のページに記載の連絡先をご確認ください。</p>
  </main>
</Layout>

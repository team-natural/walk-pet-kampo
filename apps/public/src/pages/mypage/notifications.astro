---
// SCR-32 — PRD-04 §3-1 (guarded)
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import PageHeader from "$lib/components/page-header.astro";
import { notificationLabel } from "$lib/notification-types";
import { getSession } from "$lib/server/auth/session";
import { listNotifications } from "$lib/server/services/notifications";
import type { NotificationView } from "$lib/view-models/notification";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

// First page only. Anything beyond it comes from /api/v1/me/notifications, which is cursor
// paginated — this screen has no island to ask for it yet.
const { items: notifications }: { items: NotificationView[] } = await listNotifications(db, { type: "walker", id: session.walkerId });

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<Layout title="お知らせ | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-8 px-4 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <PageHeader title="お知らせ" backHref="/mypage" backLabel="マイページ" />
      <a href="/mypage/notification-settings" class="rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">通知設定</a>
    </div>

    {
      notifications.length > 0 ? (
        <ul class="grid gap-3">
          {notifications.map((notification) => (
            <li class={`card p-6 ${notification.readAt ? "" : "border-2 border-brand-blossom/50"}`}>
              <p class="text-sm font-bold text-brand-ink-soft">{notificationLabel(notification.type)}</p>
              <p class={`mt-1 text-pretty ${notification.readAt ? "text-brand-ink-soft" : "font-bold"}`}>{notification.body}</p>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm text-brand-ink-soft tabular-nums">{dateFormat.format(new Date(notification.createdAt))}</p>
                {!notification.readAt && (
                  <form method="post" action={`/api/v1/me/notifications/${notification.id}/read`}>
                    <button type="submit" class="rounded text-sm font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">
                      既読にする
                    </button>
                  </form>
                )}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="新しいお知らせはありません。" actionHref="/mypage" actionLabel="マイページへ戻る" />
      )
    }
  </main>
</Layout>

---
// SCR-22 — PRD-04 §3-1 (guarded)
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { getWalkerProfile } from "$lib/server/services/walker-profile";
import type { WalkerProfileView } from "$lib/view-models/walker";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const profile: WalkerProfileView = await getWalkerProfile(db, session.walkerId);

// Filling these in is what moves the profile towards `active` (DEV-09 §2-4-3), so the screen
// says which are still missing rather than leaving the walker to guess why booking is closed.
const missing = [
  { label: "生年月日", filled: profile.birthdate !== null },
  { label: "電話番号", filled: profile.phone !== null },
  { label: "緊急連絡先の氏名", filled: profile.emergencyContactName !== null },
  { label: "緊急連絡先の電話番号", filled: profile.emergencyContactPhone !== null },
].filter((field) => !field.filled);

const saved = Astro.url.searchParams.get("status") === "saved";
const invalid = Astro.url.searchParams.get("error") === "input";
---

<Layout title="プロフィール編集 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-2xl gap-6 px-4 py-12">
    <PageHeader title="プロフィール編集" backHref="/mypage" backLabel="マイページ" />

    {
      saved && (
        <p role="status" class="rounded-2xl border-2 border-brand-blossom/60 bg-brand-blossom/20 px-4 py-3 text-sm font-bold">
          プロフィールを保存しました。
        </p>
      )
    }
    {
      invalid && (
        <p role="alert" class="rounded-2xl border-2 border-brand-sun/70 bg-brand-sun/25 px-4 py-3 text-sm font-bold">
          入力内容をご確認ください。
        </p>
      )
    }

    {
      missing.length > 0 && (
        <p class="rounded-2xl border-2 border-brand-sun/70 bg-brand-sun/25 px-4 py-3 text-sm">
          <span class="font-bold">おさんぽの予約には、あと {missing.length} 項目の入力が必要です。</span>
          <span class="text-brand-ink-soft">（{missing.map((field) => field.label).join("・")}）</span>
        </p>
      )
    }

    <form class="grid gap-4" method="post" action="/api/v1/me/profile">
      <fieldset class="card grid gap-4 p-6 text-sm sm:p-8">
        <legend class="px-1 font-bold">基本情報</legend>

        <label class="grid gap-1.5">
          <span class="font-bold">お名前（カナ）</span>
          <input type="text" name="nameKana" value={profile.nameKana} class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">生年月日</span>
          <input type="date" name="birthdate" value={profile.birthdate} class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">郵便番号</span>
          <input type="text" name="postalCode" value={profile.postalCode} autocomplete="postal-code" inputmode="numeric" class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">住所</span>
          <input type="text" name="address" value={profile.address} autocomplete="street-address" class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">電話番号</span>
          <input type="tel" name="phone" value={profile.phone} autocomplete="tel" class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">希望エリア</span>
          <input type="text" name="preferredArea" value={profile.preferredArea} class="field w-full" />
        </label>
      </fieldset>

      <fieldset class="card grid gap-4 p-6 text-sm sm:p-8">
        <legend class="px-1 font-bold">緊急連絡先</legend>
        <p class="text-pretty text-brand-ink-soft">当日の安全管理のために、予約が確定したおさんぽの担当スタッフにのみ共有されます。</p>

        <label class="grid gap-1.5">
          <span class="font-bold">氏名</span>
          <input type="text" name="emergencyContactName" value={profile.emergencyContactName} class="field w-full" />
        </label>

        <label class="grid gap-1.5">
          <span class="font-bold">電話番号</span>
          <input type="tel" name="emergencyContactPhone" value={profile.emergencyContactPhone} class="field w-full" />
        </label>
      </fieldset>

      <button type="submit" class="btn btn-blossom w-fit px-6 py-3">保存する</button>
    </form>
  </main>
</Layout>

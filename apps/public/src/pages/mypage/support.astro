---
// SCR-28 — PRD-04 §3-1 (guarded)
// The chart is LayerChart (DEV-01 §2) and belongs to a later pass; the totals render as text so
// the numbers are verifiable before any chart exists.
// TODO(SCR-28): replace mockReservations with getWalkerSupportTotals() — F-10-03.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import PawIcon from "$lib/components/paw-icon.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservations } from "$lib/mocks";
import { formatYen, ORGANIZATION_SHARE, PARTICIPATION_FEE } from "$lib/pricing";
import type { ReservationSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const reservations: ReservationSummary[] = mockReservations;
const totalWalks = reservations.length;
const totalPaid = reservations.reduce((sum, reservation) => sum + reservation.walkSlot.feePerPerson * reservation.participantCount, 0);
const totalDonated = Math.round((totalPaid * ORGANIZATION_SHARE) / PARTICIPATION_FEE);
---

<Layout title="支援実績 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-8 px-4 py-12">
    <PageHeader title="支援実績" lead="これまでの参加が、どれだけ保護団体の活動費になったかです。" backHref="/mypage" backLabel="マイページ" />

    <div class="grid gap-4 sm:grid-cols-3">
      <article class="card p-6">
        <p class="text-sm text-brand-ink-soft">参加したおさんぽ</p>
        <p class="mt-1 text-3xl font-bold whitespace-nowrap tabular-nums">{totalWalks} 回</p>
      </article>
      <article class="card p-6">
        <p class="text-sm text-brand-ink-soft">お支払いの合計</p>
        <p class="mt-1 text-3xl font-bold whitespace-nowrap tabular-nums">{formatYen(totalPaid)}</p>
      </article>
      <article class="card p-6">
        <p class="text-sm text-brand-ink-soft">団体への還元額</p>
        <p class="mt-1 text-3xl font-bold whitespace-nowrap text-brand-blossom-deep tabular-nums">{formatYen(totalDonated)}</p>
      </article>
    </div>

    <div class="card flex items-center gap-4 p-6">
      <PawIcon class="size-10 shrink-0 text-brand-blossom" />
      <p class="text-sm leading-relaxed text-pretty text-brand-ink-soft">還元額はフードや医療費として、保護犬のために使われます。内訳は各おさんぽの参加費から算出しています。</p>
    </div>
  </main>
</Layout>

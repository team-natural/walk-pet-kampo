---
// SCR-21 — PRD-04 §3-1 (guarded)
// Reference for how a Walker-only PAGE authenticates: it redirects rather than answering 401,
// and guards per-page (middleware.ts does security headers only).
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import LogoutButton from "../../lib/components/logout-button.svelte";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { getWalkerByPublicId, toPublicWalker } from "$lib/server/services/walkers";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

// getSession already joined walkers, so a miss here means the row vanished mid-request.
const row = await getWalkerByPublicId(db, session.walkerPublicId);
if (!row) return Astro.redirect("/auth/login", 302);
const walker = toPublicWalker(row);

const LINKS = [
  { href: "/mypage/reservations", title: "予約履歴", body: "これまでの予約と、これからのおさんぽ。" },
  { href: "/mypage/records", title: "おさんぽの記録", body: "参加したおさんぽの記録と写真。" },
  { href: "/mypage/support", title: "支援実績", body: "これまでの参加が、いくらの支援になったか。" },
  { href: "/mypage/adoption-inquiries", title: "里親相談", body: "送った相談と、そのやり取りの状況。" },
  { href: "/mypage/favorites", title: "お気に入り", body: "気になる保護犬と保護団体。" },
  { href: "/mypage/notifications", title: "お知らせ", body: "予約や相談についての通知。" },
  { href: "/mypage/profile", title: "プロフィール編集", body: "連絡先と緊急連絡先の管理。" },
  { href: "/mypage/verification", title: "本人・連絡先の確認", body: "メールと電話番号の確認状況。" },
];
---

<Layout title="マイページ | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-5xl gap-8 px-4 py-12">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <PageHeader title="マイページ">
        <p class="text-sm text-brand-ink-soft">{walker.name}（{walker.email}）</p>
      </PageHeader>
      <LogoutButton client:load />
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        LINKS.map((link, index) => (
          <li class="anim-rise card p-6" style={`--delay: ${index * 0.04}s`}>
            <h2 class="text-lg font-bold text-balance">
              <a href={link.href} class="rounded underline-offset-4 hover:underline">
                {link.title}
              </a>
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-pretty text-brand-ink-soft">{link.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="text-sm text-brand-ink-soft">
      <a href="/mypage/notification-settings" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">通知設定</a>
      <span class="mx-2" aria-hidden="true">・</span>
      <a href="/mypage/withdrawal" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">退会のお手続き</a>
    </p>
  </main>
</Layout>

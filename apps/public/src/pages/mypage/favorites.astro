---
// SCR-29 — PRD-04 §3-1 (guarded)
// favorites is polymorphic (favoritable_type / favoritable_id — DEV-07 §5-17), so the Service
// returns each kind already resolved rather than the screen branching on the raw pair.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import PageHeader from "$lib/components/page-header.astro";
import { getSession } from "$lib/server/auth/session";
import { listFavorites } from "$lib/server/services/walker-profile";
import type { DogSummary } from "$lib/view-models/dog";
import type { OrganizationSummary } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/auth/login", 302);

const favorites = await listFavorites(db, session.walkerId);
const dogs: DogSummary[] = favorites.dogs;
const organizations: OrganizationSummary[] = favorites.organizations;
---

<Layout title="お気に入り | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-4xl gap-10 px-4 py-12">
    <PageHeader title="お気に入り" backHref="/mypage" backLabel="マイページ" />

    {
      dogs.length === 0 && organizations.length === 0 ? (
        <EmptyState message="まだお気に入りはありません。気になる子や団体を見つけたら登録できます。" actionHref="/dogs" actionLabel="保護犬をさがす" />
      ) : (
        <>
          <section class="grid gap-4">
            <h2 class="text-lg font-bold">保護犬</h2>
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {dogs.map((dog) => (
                <li class="card p-6">
                  <h3 class="line-clamp-2 text-lg font-bold text-balance">
                    <a href={`/dogs/${dog.slug}`} class="rounded underline-offset-4 hover:underline">
                      {dog.name}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm text-brand-ink-soft">
                    {dog.breed} / {dog.size}
                  </p>
                </li>
              ))}
            </ul>
          </section>

          <section class="grid gap-4">
            <h2 class="text-lg font-bold">保護団体</h2>
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {organizations.map((organization) => (
                <li class="card p-6">
                  <h3 class="line-clamp-2 text-lg font-bold text-balance">
                    <a href={`/organizations/${organization.slug}`} class="rounded underline-offset-4 hover:underline">
                      {organization.name}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm text-brand-ink-soft">{organization.activityArea}</p>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
</Layout>

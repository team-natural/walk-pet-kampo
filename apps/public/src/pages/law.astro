---
// SCR-43 — PRD-04 §3-1
// TODO(SCR-43): fill in the operator's legal name, address and contact once the operating entity
// is registered — GOV-02 TBD-35, OPS-01.
import Layout from "../layouts/Layout.astro";
import PageHeader from "$lib/components/page-header.astro";
import { CANCELLATION, formatYen, PARTICIPATION_FEE } from "$lib/pricing";
---

<Layout title="特定商取引法に基づく表示 | 保護犬おさんぽマッチング">
  <main id="main-content" class="mx-auto grid max-w-3xl gap-8 px-4 py-12">
    <PageHeader title="特定商取引法に基づく表示" />

    <div class="card p-6 sm:p-10">
      <dl class="detail-list">
        <div>
          <dt>販売事業者</dt>
          <dd class="text-brand-ink-soft">（確定後に記載）</dd>
        </div>
        <div>
          <dt>運営責任者</dt>
          <dd class="text-brand-ink-soft">（確定後に記載）</dd>
        </div>
        <div>
          <dt>所在地</dt>
          <dd class="text-brand-ink-soft">（確定後に記載）</dd>
        </div>
        <div>
          <dt>お問い合わせ</dt>
          <dd>
            <a href="/contact" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">お問い合わせフォーム</a>
          </dd>
        </div>
        <div>
          <dt>販売価格</dt>
          <dd class="text-pretty">おさんぽ 1 回あたり {formatYen(PARTICIPATION_FEE)}（税込・1 名につき）。個別の金額は各おさんぽ募集のページに表示します。</dd>
        </div>
        <div>
          <dt>お支払い方法</dt>
          <dd>クレジットカード決済</dd>
        </div>
        <div>
          <dt>役務の提供時期</dt>
          <dd>各おさんぽ募集に記載の開催日時</dd>
        </div>
        <div>
          <dt>キャンセル・返金</dt>
          <dd class="text-pretty">開催の {CANCELLATION.freeCancellationHours} 時間前までのキャンセルは全額返金します。それ以降のキャンセルおよび無断不参加の場合は返金いたしません。</dd>
        </div>
      </dl>
    </div>
  </main>
</Layout>

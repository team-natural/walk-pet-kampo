---
// SCR-06 — PRD-04 §3-1 (F-07-03, F-07-04)
// Every filter is a URL query parameter and every control renders its current value back: a
// search has to survive a reload, a back button and being pasted into a message.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import EmptyState from "$lib/components/empty-state.astro";
import NearbySearch from "$lib/components/nearby-search.svelte";
import PageHeader from "$lib/components/page-header.astro";
import { formatYen } from "$lib/pricing";
import { searchWalkSlots, type WalkSlotSearchResult } from "$lib/server/services/walk-slots";
import { createDb } from "@app/schema/client";

const params = Astro.url.searchParams;
const area = params.get("area");
const date = params.get("date");
const beginnerOnly = params.get("beginner") === "1";

// A radius with no point is meaningless, so the three travel together or not at all.
const latitude = Number.parseFloat(params.get("lat") ?? "");
const longitude = Number.parseFloat(params.get("lng") ?? "");
const hasPoint = Number.isFinite(latitude) && Number.isFinite(longitude);
const radiusKm = Number.parseFloat(params.get("radius") ?? "5");

const walkSlots: WalkSlotSearchResult[] = await searchWalkSlots(createDb(env.DB), {
  area,
  date,
  beginnerOnly,
  latitude: hasPoint ? latitude : null,
  longitude: hasPoint ? longitude : null,
  radiusKm: hasPoint ? radiusKm : null,
});

const distanceFormat = new Intl.NumberFormat("ja-JP", { maximumFractionDigits: 1 });

const dateFormat = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
---

<Layout title="おさんぽをさがす | 保護犬おさんぽマッチング" description="エリアと日付から、参加できる保護犬のおさんぽを探せます。">
  <main id="main-content" class="mx-auto grid max-w-6xl gap-8 px-4 py-12">
    <PageHeader title="おさんぽをさがす" lead="エリアと日付で絞り込めます。はじめての方でも参加できる枠には印が付いています。" />

    <form id="walk-search" action="/walks" method="get" role="search" aria-label="おさんぽの検索" class="card grid gap-3 p-4">
      <div class="grid gap-3 sm:grid-cols-[1fr_11rem_auto]">
        <label>
          <span class="sr-only">エリア</span>
          <input type="search" name="area" value={area} autocomplete="off" spellcheck="false" placeholder="エリア（例: 東京都北区）" class="field w-full" />
        </label>
        <label>
          <span class="sr-only">おさんぽの日付</span>
          <input type="date" name="date" value={date} autocomplete="off" class="field w-full" />
        </label>
        <button type="submit" class="btn btn-blossom px-6">さがす</button>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-1 text-sm">
        <label class="flex items-center gap-2">
          <input type="checkbox" name="beginner" value="1" checked={beginnerOnly} class="size-5 accent-brand-blossom-deep" />
          <span>はじめての方でも参加できる枠だけ</span>
        </label>

        <label class="flex items-center gap-2">
          <span>現在地から</span>
          <select name="radius" class="field py-1.5">
            {
              [3, 5, 10, 30].map((km) => (
                <option value={km} selected={hasPoint && radiusKm === km}>
                  {km} km 以内
                </option>
              ))
            }
          </select>
        </label>

        {/* The point itself comes from the browser, so these are filled by the island next to them. */}
        <input type="hidden" name="lat" value={hasPoint ? latitude : ""} />
        <input type="hidden" name="lng" value={hasPoint ? longitude : ""} />
        <NearbySearch client:load form="walk-search" />

        {
          hasPoint && (
            <a href="/walks" class="rounded font-bold text-brand-blossom-deep underline decoration-2 underline-offset-4 hover:text-brand-ink">
              現在地の条件を外す
            </a>
          )
        }
      </div>
    </form>

    {
      walkSlots.length > 0 ? (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {walkSlots.map((slot, index) => (
            <li class="anim-rise card flex flex-col p-6" style={`--delay: ${index * 0.06}s`}>
              <p class="flex flex-wrap items-center gap-x-2 text-sm font-bold text-brand-ink-soft">
                <span>
                  {slot.areaPrefecture}
                  {slot.areaCity}
                </span>
                <span aria-hidden="true">・</span>
                <time datetime={slot.startAt}>{dateFormat.format(new Date(slot.startAt))}</time>
              </p>

              <h2 class="mt-2 line-clamp-2 text-lg font-bold text-balance">
                <a href={`/walks/${slot.id}`} class="rounded underline-offset-4 hover:underline">
                  {slot.title}
                </a>
              </h2>

              <div class="mt-4 flex flex-wrap gap-2">
                {slot.beginnerAllowed === 1 && <span class="badge">はじめての方歓迎</span>}
                <span class="badge badge-blossom tabular-nums">
                  残り {slot.remainingCapacity} / {slot.capacity} 名
                </span>
                {slot.distanceKm !== null && <span class="badge badge-quiet tabular-nums">現在地から {distanceFormat.format(slot.distanceKm)} km</span>}
              </div>

              <p class="mt-4 font-bold whitespace-nowrap tabular-nums">{formatYen(slot.feePerPerson)} / 名</p>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="この条件で募集中のおさんぽは見つかりませんでした。" actionHref="/organizations" actionLabel="参加している保護団体を見る" />
      )
    }
  </main>
</Layout>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "walk-pet-kampo-admin",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // This Worker sits behind Cloudflare Access (GOV-01 D-031). The application is created in the
  // Zero Trust dashboard against the Worker *name* — not a hostname or route — so it covers
  // production and Preview deployments without per-route configuration, and there is no
  // workers.dev bypass to remember. Nothing about that lives in this file.
  //
  // `access.dev` only affects local runs: it injects the identity that `ctx.access` would
  // otherwise carry, so the authenticated path can be exercised without deploying. Removing the
  // block simulates an unauthenticated request.
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": { "email": "admin@example.test" },
    },
  },

  // vars is non-inheritable, so it's repeated in each env block below.
  "vars": {
    "SESSION_TTL_DAYS": "30",
    "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
    "AUTH_LOCKOUT_MINUTES": "15",
  },

  // Shared with apps/public: create once, then copy the ids into both. They must match —
  // database_id also keys the shared local sqlite file. KV is admin-only.
  // migrations_dir is non-inheritable, like vars above.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-db-name",
      "database_id": "replace-with-database-id",
      "migrations_dir": "../../packages/schema/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "replace-with-bucket-name",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "replace-with-kv-namespace-id",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-staging",
          "database_id": "replace-with-database-id-staging",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-staging" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-staging" }],
    },
    "production": {
      "vars": {
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-production",
          "database_id": "replace-with-database-id-production",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-production" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-production" }],
    },
  },
}

---
// SYS-12 — PRD-04 §3-3
// Read-only until P14, like SYS-10: the write side is `updateWalkSlotByPlatform` over the Service
// Binding (DEV-04 §5-15) and the admin-side route that calls it is GOV-02 TBD-58. The edit sheet
// and the cancel action stay in `walk-slot-edit-sheet.svelte` for it.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDateTime, formatYen } from "$lib/format";
import { getSession } from "$lib/server/auth/session";
import { getWalkSlotByPublicId } from "$lib/server/services/walk-slots";
import { label, yesNo } from "$lib/status";
import type { WalkSlotDetail } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const slot: WalkSlotDetail = await getWalkSlotByPublicId(db, publicId!);
---

<ConsoleLayout title={slot.title} user={session} breadcrumbs={[{ label: "お散歩募集", href: "/walks" }, { label: slot.title }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={slot.title} description={slot.organizationName}>
      <Fragment slot="meta">
        <p class="pt-1"><StatusBadge domain="walkSlot" value={slot.status} /></p>
      </Fragment>
    </PageHeader>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="開催情報">
        <div><dt>開催日時</dt><dd class="tabular-nums">{formatDateTime(slot.startAt)}（{slot.durationMinutes} 分）</dd></div>
        <div><dt>集合場所</dt><dd>{slot.meetingPlace}</dd></div>
        <div><dt>エリア</dt><dd>{slot.areaPrefecture}{slot.areaCity}</dd></div>
        <div><dt>予約状況</dt><dd class="tabular-nums">{slot.reservedCount} / {slot.capacity} 名</dd></div>
        <div><dt>参加費</dt><dd class="whitespace-nowrap tabular-nums">{formatYen(slot.feePerPerson)}</dd></div>
        <div><dt>受付期間</dt><dd class="tabular-nums">{formatDateTime(slot.acceptanceStartAt)} 〜 {formatDateTime(slot.acceptanceEndAt)}</dd></div>
        <div><dt>スタッフ同行</dt><dd>{yesNo(slot.staffAccompanied)}</dd></div>
      </DetailCard>

      <DetailCard title="参加条件">
        <div><dt>必要な経験</dt><dd>{label("requiredExperience", slot.requiredExperience)}</dd></div>
        <div><dt>初心者</dt><dd>{yesNo(slot.beginnerAllowed, "可", "不可")}</dd></div>
        <div><dt>お子さま同伴</dt><dd>{yesNo(slot.childAllowed, "可", "不可")}</dd></div>
        <div><dt>年齢制限</dt><dd class="tabular-nums">{slot.minAge === null ? "—" : `${slot.minAge} 歳以上`}</dd></div>
        <div><dt>服装</dt><dd>{slot.clothingNotes ?? "—"}</dd></div>
        <div><dt>荒天時</dt><dd>{slot.weatherPolicy ?? "—"}</dd></div>
        <div><dt>キャンセル規定</dt><dd>{slot.cancellationPolicy ?? "—"}</dd></div>
      </DetailCard>
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="募集内容" list={false}>
        <p class="text-sm whitespace-pre-wrap">{slot.description ?? "—"}</p>
      </DetailCard>

      <DetailCard title="注意事項" list={false}>
        <p class="text-sm whitespace-pre-wrap">{slot.precautions ?? "—"}</p>
      </DetailCard>
    </div>
  </div>
</ConsoleLayout>

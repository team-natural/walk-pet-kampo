---
// SYS-11 — PRD-04 §3-3
// TODO(SYS-11): replace mockWalkSlots with listWalkSlots() — F-15-06.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { mockWalkSlots } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { WalkSlotSummary } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const slots: WalkSlotSummary[] = mockWalkSlots;
---

<ConsoleLayout title="お散歩募集" user={session} breadcrumbs={[{ label: "お散歩募集" }]}>
  <PageHeader title="お散歩募集" description="全団体のおさんぽ募集を横断して確認します。開催の近い順に並びます。" />

  <DataTable caption="お散歩募集の一覧" columns={["タイトル", "団体", "開催日時", "エリア", "予約", "状態"]} rowCount={slots.length} emptyTitle="募集がありません" emptyDescription="団体がおさんぽ募集を公開するとここに表示されます。" emptyActionHref="/organizations" emptyActionLabel="保護団体一覧を見る">
    {
      slots.map((slot) => (
        <Table.Row>
          <Table.Cell>
            <RowLink href={`/walks/${slot.id}`}>{slot.title}</RowLink>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{slot.organizationName}</Table.Cell>
          <Table.Cell class="whitespace-nowrap tabular-nums">{formatDateTime(slot.startAt)}</Table.Cell>
          <Table.Cell class="text-muted-foreground">
            {slot.areaPrefecture}
            {slot.areaCity}
          </Table.Cell>
          <Table.Cell class="tabular-nums">
            {slot.reservedCount} / {slot.capacity}
          </Table.Cell>
          <Table.Cell>
            <StatusBadge domain="walkSlot" value={slot.status} />
          </Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

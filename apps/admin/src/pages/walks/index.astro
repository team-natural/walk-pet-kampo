---
// SYS-11 お散歩募集一覧（横断） — PRD-04 §3-3
// TODO(SYS-11): replace mockWalkSlots with listWalkSlots() — F-15-06.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockWalkSlots } from "$lib/mocks";
import type { WalkSlotSummary } from "$lib/view-models/walk-slot";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const walkSlots: WalkSlotSummary[] = mockWalkSlots;
---

<Layout title="お散歩募集 — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">お散歩募集</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">タイトル</th>
          <th class="py-2">団体</th>
          <th class="py-2">開催</th>
          <th class="py-2">予約</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          walkSlots.map((slot) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/walks/${slot.id}`}>{slot.title}</a>
              </td>
              <td class="py-2">{slot.organizationName}</td>
              <td class="py-2">{slot.startAt}</td>
              <td class="py-2">
                {slot.reservedCount} / {slot.capacity}
              </td>
              <td class="py-2">{slot.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

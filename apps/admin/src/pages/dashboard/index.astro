---
// SYS-01 — PRD-04 §3-3
// TODO(SYS-01): replace mockDashboard with getDashboard() — F-15-01.
// Reference for how a PAGE authenticates: unlike an API route it redirects instead of
// answering 401, and the guard is per-page (middleware.ts deliberately doesn't do auth).
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import SeverityBadge from "$lib/components/severity-badge.svelte";
import * as Card from "$lib/components/ui/card/index.js";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { mockDashboard } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { DashboardView } from "$lib/view-models/dashboard";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const dashboard: DashboardView = mockDashboard;
---

<ConsoleLayout title="ダッシュボード" user={session} breadcrumbs={[{ label: "ダッシュボード" }]}>
  <PageHeader title="ダッシュボード" description="審査・安全対応・お問い合わせの未処理をまとめて確認できます。" />

  <section class="flex flex-col gap-3" aria-labelledby="kpi-heading">
    <h2 id="kpi-heading" class="sr-only">未処理の件数</h2>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        dashboard.tiles.map((tile) => (
          <Card.Root class="relative" size="sm">
            <Card.Header>
              <Card.Description>{tile.label}</Card.Description>
              <Card.Title class="text-3xl tabular-nums">
                {tile.value}
                <span class="ms-1 text-sm font-normal text-muted-foreground">件</span>
              </Card.Title>
            </Card.Header>
            {tile.href && (
              <Card.Footer>
                <a href={tile.href} class="rounded-sm text-sm font-medium text-primary underline-offset-4 after:absolute after:inset-0 hover:underline">
                  一覧を開く
                </a>
              </Card.Footer>
            )}
          </Card.Root>
        ))
      }
    </div>
  </section>

  <div class="grid items-start gap-6 xl:grid-cols-2">
    <DataTable title="審査待ちの登録申請" description="申請の古い順に表示しています。" actionHref="/organization-applications" actionLabel="すべて見る" caption="審査待ちの保護団体登録申請" columns={["団体名", "申請日時"]} rowCount={dashboard.pendingApplications.length} emptyTitle="審査待ちの申請はありません" emptyDescription="新しい申請が届くとここに表示されます。" emptyActionHref="/organizations" emptyActionLabel="保護団体一覧を見る">
      {
        dashboard.pendingApplications.map((application) => (
          <Table.Row>
            <Table.Cell>
              <RowLink href={`/organization-applications/${application.id}`}>{application.name}</RowLink>
            </Table.Cell>
            <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDateTime(application.submittedAt)}</Table.Cell>
          </Table.Row>
        ))
      }
    </DataTable>

    <DataTable title="直近の事故・トラブル" description="P1 は当日中の一次対応が必要です。" actionHref="/incidents" actionLabel="すべて見る" caption="直近に報告された事故・トラブル" columns={["団体名", "重大度", "発生日時"]} rowCount={dashboard.recentIncidents.length} emptyTitle="未対応の報告はありません" emptyDescription="団体から報告が届くとここに表示されます。" emptyActionHref="/incidents" emptyActionLabel="対応済みの報告を見る">
      {
        dashboard.recentIncidents.map((incident) => (
          <Table.Row>
            <Table.Cell>
              <RowLink href={`/incidents/${incident.id}`}>{incident.organizationName}</RowLink>
            </Table.Cell>
            <Table.Cell>
              <SeverityBadge severity={incident.severity} />
            </Table.Cell>
            <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDateTime(incident.occurredAt)}</Table.Cell>
          </Table.Row>
        ))
      }
    </DataTable>
  </div>
</ConsoleLayout>

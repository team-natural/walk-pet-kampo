---
// SYS-25 — PRD-04 §3-3
// activity_log is append-only, so this screen has no action of any kind — a delete here would
// defeat the record it displays.
// TODO(SYS-25): replace mockAuditLog with listActivityLog() — F-15-13.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import { Badge } from "$lib/components/ui/badge/index.js";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { mockAuditLog } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { AuditLogEntry } from "$lib/view-models/audit-log";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const entries: AuditLogEntry[] = mockAuditLog;
---

<ConsoleLayout title="管理操作履歴" user={session} breadcrumbs={[{ label: "管理操作履歴" }]}>
  <PageHeader title="管理操作履歴" description="状態変更と管理操作の記録です。追記のみで、消すことはできません。" />

  <DataTable caption="管理操作履歴の一覧" columns={["日時", "操作者", "対象", "操作", "内容"]} rowCount={entries.length} emptyTitle="記録がありません" emptyDescription="状態変更や管理操作が行われるとここに残ります。">
    {
      entries.map((entry) => (
        <Table.Row>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDateTime(entry.createdAt)}</Table.Cell>
          <Table.Cell>
            {entry.causerName}
            <span class="ms-1 text-xs text-muted-foreground">{entry.causerType}</span>
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap">
            <span class="font-mono text-xs">
              {entry.subjectType} #{entry.subjectId}
            </span>
          </Table.Cell>
          <Table.Cell>
            <Badge variant="outline">{entry.event}</Badge>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{entry.description}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

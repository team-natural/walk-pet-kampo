---
// SYS-05 — PRD-04 §3-3
// Organization review is the one transition that lives in apps/admin rather than apps/public
// (DEV-09 §2-1-5), so this screen calls a local Service, not the RPC.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConfirmAction from "$lib/components/confirm-action.svelte";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDate, formatPostalCode } from "$lib/format";
import { getSession } from "$lib/server/auth/session";
import { allowedTransitions, getOrganizationByPublicId } from "$lib/server/services/organizations";
import { label, yesNo } from "$lib/status";
import type { OrganizationDetail } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const organization: OrganizationDetail = await getOrganizationByPublicId(db, publicId!);
const transitionAction = `/api/v1/organizations/${organization.id}/transition`;

// Only the moves DEV-09 §2-1-2 allows from here. An operator offered a button that 409s has been
// shown a stale screen, and the state machine is the only thing that knows which those are.
const canMoveTo = (to: string) => allowedTransitions(organization.status).includes(to as OrganizationDetail["status"]);

const ERRORS: Record<string, string> = {
  reason: "理由を入力してください。",
  state: "この申請の状態が変わっています。画面を再読み込みしてください。",
};
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
---

<ConsoleLayout title={`${organization.name} の審査`} user={session} breadcrumbs={[{ label: "登録申請", href: "/organization-applications" }, { label: organization.name }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={organization.name} description={organization.nameKana ?? undefined}>
      <Fragment slot="meta">
        <p class="pt-1"><StatusBadge domain="organization" value={organization.status} /></p>
      </Fragment>
      <Fragment slot="actions">
        {canMoveTo("under_review") && <ConfirmAction client:load action={transitionAction} name="to" value="under_review" triggerLabel="審査を開始する" title="審査を開始しますか？" message="この申請を審査中にします。団体への通知は送られません。" confirmLabel="開始する" />}
        {canMoveTo("approved") && <ConfirmAction client:load action={transitionAction} name="to" value="approved" triggerLabel="承認する" title="この団体を承認しますか？" message="承認すると団体ページが使えるようになり、おさんぽ募集の公開が可能になります。承認の通知メールが送られます。" confirmLabel="承認する" />}
        {canMoveTo("needs_more_info") && <ConfirmAction client:load action={transitionAction} name="to" value="needs_more_info" triggerLabel="差し戻す" title="追加の情報を依頼しますか？" message="入力いただいた内容はそのまま残り、団体側で修正して再申請できます。記入した理由がそのまま通知されます。" confirmLabel="差し戻す" reasonLabel="確認したい内容（必須）" reasonRequired />}
        {canMoveTo("rejected") && <ConfirmAction client:load action={transitionAction} name="to" value="rejected" destructive triggerLabel="否認する" title="この申請を否認しますか？" message="否認は取り消せません。同じ団体が再申請するには、新しく申請し直す必要があります。" confirmLabel="否認する" reasonLabel="否認の理由（必須）" reasonRequired />}
      </Fragment>
    </PageHeader>

    {
      error && (
        <p role="alert" class="rounded-lg border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm font-medium">
          {error}
        </p>
      )
    }

    {
      organization.rejectionReason && (
        <p class="rounded-lg bg-muted px-4 py-3 text-sm">
          <span class="font-medium">前回の差し戻し理由：</span>
          {organization.rejectionReason}
        </p>
      )
    }

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="申請内容">
        <div><dt>団体種別</dt><dd>{label("orgType", organization.orgType)}</dd></div>
        <div><dt>法人格</dt><dd>{yesNo(organization.hasCorporateStatus)}</dd></div>
        <div><dt>代表者</dt><dd>{organization.representativeName}</dd></div>
        <div><dt>担当者</dt><dd>{organization.contactName}</dd></div>
        <div><dt>所在地</dt><dd>{formatPostalCode(organization.postalCode)} {organization.address}</dd></div>
        <div><dt>住所の公開範囲</dt><dd>{label("addressVisibility", organization.addressVisibility)}</dd></div>
        <div><dt>連絡先</dt><dd>{organization.email}<span class="ms-2 tabular-nums">{organization.phone}</span></dd></div>
        <div>
          <dt>ウェブサイト</dt>
          <dd>
            {
              organization.website ? (
                <a href={organization.website} class="rounded-sm underline underline-offset-4" rel="noreferrer noopener" target="_blank">
                  {organization.website}
                </a>
              ) : (
                "—"
              )
            }
          </dd>
        </div>
      </DetailCard>

      <DetailCard title="活動実績">
        <div><dt>活動地域</dt><dd>{organization.activityArea ?? "—"}</dd></div>
        <div><dt>活動開始</dt><dd class="tabular-nums">{organization.activityStartedOn ? formatDate(organization.activityStartedOn) : "—"}</dd></div>
        <div><dt>保護頭数</dt><dd class="tabular-nums">{organization.protectedDogCount === null ? "—" : `${organization.protectedDogCount} 頭`}</dd></div>
        <div><dt>譲渡実績</dt><dd>{organization.adoptionTrackRecord ?? "—"}</dd></div>
        <div><dt>申請日</dt><dd class="tabular-nums">{formatDate(organization.createdAt)}</dd></div>
        <div><dt>審査担当</dt><dd>{organization.reviewedByName ?? "—"}</dd></div>
      </DetailCard>
    </div>

    <DetailCard title="団体紹介" list={false}>
      <p class="text-sm whitespace-pre-wrap">{organization.introduction ?? "—"}</p>
    </DetailCard>
  </div>
</ConsoleLayout>

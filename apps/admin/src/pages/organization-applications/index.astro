---
// SYS-04 — PRD-04 §3-3
// TODO(SYS-04): replace mockOrganizations with listOrganizationApplications() — F-15-03.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { mockOrganizations } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { OrganizationSummary } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const applications: OrganizationSummary[] = mockOrganizations;
---

<ConsoleLayout title="登録申請" user={session} breadcrumbs={[{ label: "登録申請" }]}>
  <PageHeader title="登録申請" description="保護団体からの登録申請を審査します。申請の古い順に並びます。" />

  <DataTable caption="保護団体の登録申請一覧" columns={["団体名", "活動地域", "状態", "申請日"]} rowCount={applications.length} emptyTitle="審査待ちの申請はありません" emptyDescription="新しい申請が届くとここに表示されます。" emptyActionHref="/organizations" emptyActionLabel="保護団体一覧を見る">
    {
      applications.map((application) => (
        <Table.Row>
          <Table.Cell>
            <a href={`/organization-applications/${application.id}`} class="rounded-sm font-medium underline-offset-4 hover:underline">
              {application.name}
            </a>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{application.activityArea ?? "—"}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="organization" value={application.status} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(application.createdAt)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

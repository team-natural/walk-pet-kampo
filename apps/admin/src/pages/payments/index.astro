---
// SYS-15 — PRD-04 §3-3
// TODO(SYS-15): replace mockPayments with listPayments() — F-15-08.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime, formatYen } from "$lib/format";
import { mockPayments } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { PaymentSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const payments: PaymentSummary[] = mockPayments;
---

<ConsoleLayout title="決済・返金" user={session} breadcrumbs={[{ label: "決済・返金" }]}>
  <PageHeader title="決済・返金" description="参加費の決済状況を確認し、返金を処理します。決済の実体は Stripe 側にあります。" />

  <DataTable caption="決済・返金の一覧" columns={["決済 ID", "参加費", "団体還元", "状態", "決済日時"]} rowCount={payments.length} emptyTitle="決済がありません" emptyDescription="予約が確定するとここに表示されます。" emptyActionHref="/reservations" emptyActionLabel="予約一覧を見る">
    {
      payments.map((payment) => (
        <Table.Row>
          <Table.Cell>
            <a href={`/payments/${payment.id}`} class="rounded-sm font-mono text-xs font-medium underline-offset-4 hover:underline">
              {payment.stripePaymentIntentId ?? payment.id}
            </a>
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap tabular-nums">{formatYen(payment.amount)}</Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatYen(payment.organizationShareAmount)}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="payment" value={payment.status} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{payment.paidAt ? formatDateTime(payment.paidAt) : "—"}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

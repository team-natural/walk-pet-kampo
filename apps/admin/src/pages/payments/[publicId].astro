---
// SYS-16 — PRD-04 §3-3
// Refund runs through `refundPayment` on apps/public's AdminOps entrypoint (DEV-04 §5-15); the
// admin-side HTTP wrapper this form posts to is still TBD-58.
// TODO(SYS-16): replace mockPaymentSummary with getPayment() and post refundPayment() — F-15-08.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import PaymentRefundSheet from "$lib/components/payment-refund-sheet.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDateTime, formatYen } from "$lib/format";
import { mockPaymentSummary } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { PaymentSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const payment: PaymentSummary = mockPaymentSummary;
const refundable = payment.status === "paid";
---

<ConsoleLayout title="決済の詳細" user={session} breadcrumbs={[{ label: "決済・返金", href: "/payments" }, { label: "決済の詳細" }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={formatYen(payment.amount)} description="参加費の決済 1 件">
      <Fragment slot="meta">
        <p class="pt-1"><StatusBadge domain="payment" value={payment.status} /></p>
      </Fragment>
      <Fragment slot="actions">
        {refundable && <PaymentRefundSheet client:load payment={payment} action={`/api/v1/payments/${payment.id}/refund`} />}
      </Fragment>
    </PageHeader>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="内訳">
        <div><dt>参加費</dt><dd class="whitespace-nowrap tabular-nums">{formatYen(payment.amount)}</dd></div>
        <div><dt>団体への還元</dt><dd class="whitespace-nowrap tabular-nums">{formatYen(payment.organizationShareAmount)}</dd></div>
        <div><dt>プラットフォーム手数料</dt><dd class="whitespace-nowrap tabular-nums">{formatYen(payment.platformFeeAmount)}</dd></div>
        <div><dt>通貨</dt><dd>{payment.currency}</dd></div>
      </DetailCard>

      <DetailCard title="処理状況">
        <div><dt>決済日時</dt><dd class="tabular-nums">{payment.paidAt ? formatDateTime(payment.paidAt) : "—"}</dd></div>
        <div><dt>返金日時</dt><dd class="tabular-nums">{payment.refundedAt ? formatDateTime(payment.refundedAt) : "—"}</dd></div>
        <div><dt>返金額</dt><dd class="whitespace-nowrap tabular-nums">{payment.refundAmount === null ? "—" : formatYen(payment.refundAmount)}</dd></div>
        <div><dt>失敗理由</dt><dd>{payment.failureReason ?? "—"}</dd></div>
        <div>
          <dt>Stripe PaymentIntent</dt>
          <dd>{payment.stripePaymentIntentId ? <span class="font-mono text-xs break-all">{payment.stripePaymentIntentId}</span> : "—"}</dd>
        </div>
      </DetailCard>
    </div>

    <p class="text-sm text-muted-foreground">返金の詳細な履歴は Stripe ダッシュボードで PaymentIntent を検索してください。</p>
  </div>
</ConsoleLayout>

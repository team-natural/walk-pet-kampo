---
// SYS-24 — PRD-04 §3-3
// No mock: the Service already exists. Status moves through one route per transition, never a
// PATCH on status (DEV-05, services/inquiries.ts).
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { allowedTransitions, getInquiryByPublicId } from "$lib/server/services/inquiries";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const inquiry = publicId ? await getInquiryByPublicId(db, publicId) : undefined;
if (!inquiry) return Astro.redirect("/inquiries", 302);

const transitions = allowedTransitions(inquiry.status);
---

<Layout title="お問い合わせの詳細 — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">{inquiry.name} さんからのお問い合わせ</h1>

    <dl class="grid gap-1 text-sm">
      <div><dt class="inline text-muted-foreground">受付日</dt> <dd class="inline">{inquiry.createdAt}</dd></div>
      <div><dt class="inline text-muted-foreground">種別</dt> <dd class="inline">{inquiry.type}</dd></div>
      <div><dt class="inline text-muted-foreground">メールアドレス</dt> <dd class="inline">{inquiry.email}</dd></div>
      <div><dt class="inline text-muted-foreground">状態</dt> <dd class="inline">{inquiry.status}</dd></div>
    </dl>

    <p class="text-sm whitespace-pre-wrap">{inquiry.message}</p>

    <form class="flex gap-2 text-sm" method="post">
      {
        transitions.map((to) => (
          <button type="submit" formaction={`/api/v1/inquiries/${inquiry.id}/${to === "in_progress" ? "start" : to === "resolved" ? "resolve" : "reopen"}`} class="rounded border px-3 py-2">
            {to} にする
          </button>
        ))
      }
    </form>
  </main>
</Layout>

---
// SYS-02 — PRD-04 §3-3
// TODO(SYS-02): replace mockWalkers with listWalkers() — F-15-02.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { mockWalkers } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { WalkerSummary } from "$lib/view-models/walker";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const walkers: WalkerSummary[] = mockWalkers;
---

<ConsoleLayout title="お散歩参加者" user={session} breadcrumbs={[{ label: "お散歩参加者" }]}>
  <PageHeader title="お散歩参加者" description="登録済みの参加者を横断して確認し、利用制限・停止を行います。" />

  <DataTable caption="お散歩参加者の一覧" columns={["氏名", "メールアドレス", "状態", "登録日"]} rowCount={walkers.length} emptyTitle="参加者がいません" emptyDescription="公開サイトから登録があるとここに表示されます。">
    {
      walkers.map((walker) => (
        <Table.Row>
          <Table.Cell>
            <a href={`/walkers/${walker.id}`} class="rounded-sm font-medium underline-offset-4 hover:underline">
              {walker.name}
            </a>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{walker.email}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="walkerProfile" value={walker.profileStatus} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(walker.createdAt)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

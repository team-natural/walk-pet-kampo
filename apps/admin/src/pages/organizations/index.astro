---
// SYS-06 — PRD-04 §3-3
// TODO(SYS-06): replace mockOrganizations with listOrganizations() — F-15-04.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { mockOrganizations } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { OrganizationSummary } from "$lib/view-models/organization";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const organizations: OrganizationSummary[] = mockOrganizations;
---

<ConsoleLayout title="保護団体" user={session} breadcrumbs={[{ label: "保護団体" }]}>
  <PageHeader title="保護団体" description="承認済みの団体を横断して確認し、掲載停止・活動停止を行います。" />

  <DataTable caption="保護団体の一覧" columns={["団体名", "活動地域", "状態", "登録日"]} rowCount={organizations.length} emptyTitle="登録済みの団体がありません" emptyDescription="登録申請を承認すると、その団体がここに並びます。" emptyActionHref="/organization-applications" emptyActionLabel="登録申請を見る">
    {
      organizations.map((organization) => (
        <Table.Row>
          <Table.Cell>
            <RowLink href={`/organizations/${organization.id}`}>{organization.name}</RowLink>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{organization.activityArea ?? "—"}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="organization" value={organization.status} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(organization.createdAt)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

---
// SYS-08 団体スタッフ一覧（横断） — PRD-04 §3-3
// organization_members has no public_id, so the rows are addressed under their organization's
// key rather than their own (DEV-07 §5-5).
// TODO(SYS-08): replace mockOrganizationMembers with listOrganizationMembers() — F-15-04.
import { env } from "cloudflare:workers";
import Layout from "../../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockOrganizationMembers } from "$lib/mocks";
import type { OrganizationMemberView } from "$lib/view-models/organization-member";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const members: OrganizationMemberView[] = mockOrganizationMembers;
---

<Layout title="団体スタッフ — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-4xl flex-col gap-6 p-6" data-public-id={publicId}>
    <h1 class="text-2xl font-bold">団体スタッフ</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">氏名</th>
          <th class="py-2">メールアドレス</th>
          <th class="py-2">権限</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          members.map((member) => (
            <tr class="border-b">
              <td class="py-2">{member.name}</td>
              <td class="py-2">{member.email}</td>
              <td class="py-2">{member.role}</td>
              <td class="py-2">{member.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

---
// SYS-08 — PRD-04 §3-3
// organization_members has no public_id, so the rows are addressed under their organization's
// key rather than their own (DEV-07 §5-5).
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { getSession } from "$lib/server/auth/session";
import { listOrganizationMembers } from "$lib/server/services/organizations";
import { label } from "$lib/status";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const { organization, members } = await listOrganizationMembers(db, publicId!);
---

<ConsoleLayout title={`${organization.name} のスタッフ`} user={session} breadcrumbs={[{ label: "保護団体", href: "/organizations" }, { label: organization.name, href: `/organizations/${publicId}` }, { label: "スタッフ" }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title="団体スタッフ" description={`${organization.name} に所属するスタッフの一覧です。追加・削除は団体側で行います。`} />

    <DataTable caption="団体スタッフの一覧" columns={["氏名", "メールアドレス", "権限", "状態", "参加日"]} rowCount={members.length} emptyTitle="スタッフが登録されていません" emptyDescription="団体管理者が招待するとここに表示されます。" emptyActionHref={`/organizations/${publicId}`} emptyActionLabel="団体の詳細へ戻る">
      {
        members.map((member) => (
          <Table.Row>
            <Table.Cell class="font-medium">{member.name}</Table.Cell>
            <Table.Cell class="text-muted-foreground">{member.email}</Table.Cell>
            <Table.Cell>{label("memberRole", member.role)}</Table.Cell>
            <Table.Cell>
              <StatusBadge domain="organizationMember" value={member.status} />
            </Table.Cell>
            <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">
              {member.joinedAt ? formatDate(member.joinedAt) : "—"}
              {member.leftAt && <span class="ms-2">退出 {formatDate(member.leftAt)}</span>}
            </Table.Cell>
          </Table.Row>
        ))
      }
    </DataTable>
  </div>
</ConsoleLayout>

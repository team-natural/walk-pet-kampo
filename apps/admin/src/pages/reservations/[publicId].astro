---
// SYS-14 — PRD-04 §3-3
// Reservation transitions live in apps/public, so a cancellation here goes over the Service
// Binding RPC (GOV-01 D-022).
// TODO(SYS-14): replace mockReservationDetail with getReservation() and post
// transitionReservation() — F-15-07.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConfirmAction from "$lib/components/confirm-action.svelte";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import { Button } from "$lib/components/ui/button/index.js";
import { formatDateTime, formatYen } from "$lib/format";
import { mockReservationDetail } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const reservation: ReservationDetail = mockReservationDetail;
---

<ConsoleLayout title={`${reservation.walkerName} の予約`} user={session} breadcrumbs={[{ label: "予約", href: "/reservations" }, { label: reservation.walkerName }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={reservation.walkSlotTitle} description={`${reservation.walkerName} さん / ${reservation.organizationName}`}>
      <Fragment slot="meta">
        <p class="pt-1"><StatusBadge client:load domain="reservation" value={reservation.status} /></p>
      </Fragment>
      <Fragment slot="actions">
        {
          reservation.payment && (
            <Button href={`/payments/${reservation.payment.id}`} variant="outline" size="sm">
              決済を見る
            </Button>
          )
        }
        <ConfirmAction client:load action={`/api/v1/reservations/${reservation.id}/transition`} name="to" value="cancelled_by_platform" destructive triggerLabel="キャンセル代行" title="運営としてこの予約をキャンセルしますか？" message="参加者と団体の双方に通知が送られ、決済済みの参加費は返金の対象になります。この操作は取り消せません。" confirmLabel="キャンセルする" reasonLabel="キャンセルの理由（必須・双方に通知されます）" reasonRequired />
      </Fragment>
    </PageHeader>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="予約内容">
        <div><dt>参加者</dt><dd>{reservation.walkerName}</dd></div>
        <div><dt>参加人数</dt><dd class="tabular-nums">{reservation.participantCount} 名</dd></div>
        <div><dt>おさんぽ</dt><dd>{reservation.walkSlotTitle}</dd></div>
        <div><dt>団体</dt><dd>{reservation.organizationName}</dd></div>
        <div><dt>予約日時</dt><dd class="tabular-nums">{formatDateTime(reservation.createdAt)}</dd></div>
        <div><dt>仮押さえ期限</dt><dd class="tabular-nums">{reservation.expiresAt ? formatDateTime(reservation.expiresAt) : "—"}</dd></div>
        <div><dt>最終更新</dt><dd class="tabular-nums">{formatDateTime(reservation.updatedAt)}</dd></div>
      </DetailCard>

      <DetailCard title="緊急連絡先" description="予約時点の控えです。参加者が後から変更しても、この記録は変わりません。">
        <div><dt>お名前</dt><dd>{reservation.emergencyContactNameSnapshot ?? "—"}</dd></div>
        <div><dt>電話番号</dt><dd class="tabular-nums">{reservation.emergencyContactPhoneSnapshot ?? "—"}</dd></div>
        <div><dt>キャンセル日時</dt><dd class="tabular-nums">{reservation.cancelledAt ? formatDateTime(reservation.cancelledAt) : "—"}</dd></div>
        <div><dt>キャンセル理由</dt><dd class="whitespace-pre-wrap">{reservation.cancelledReason ?? "—"}</dd></div>
      </DetailCard>
    </div>

    {
      reservation.payment && (
        <DetailCard title="決済">
          <div>
            <dt>状態</dt>
            <dd>
              <StatusBadge client:load domain="payment" value={reservation.payment.status} />
            </dd>
          </div>
          <div>
            <dt>参加費</dt>
            <dd class="whitespace-nowrap tabular-nums">{formatYen(reservation.payment.amount)}</dd>
          </div>
          <div>
            <dt>団体への還元</dt>
            <dd class="whitespace-nowrap tabular-nums">{formatYen(reservation.payment.organizationShareAmount)}</dd>
          </div>
          <div>
            <dt>決済日時</dt>
            <dd class="tabular-nums">{reservation.payment.paidAt ? formatDateTime(reservation.payment.paidAt) : "—"}</dd>
          </div>
        </DetailCard>
      )
    }
  </div>
</ConsoleLayout>

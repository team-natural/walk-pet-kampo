---
// SYS-14 予約詳細・編集 — PRD-04 §3-3
// Cancelling on the walker's behalf is a transition on an apps/public domain, so it goes over the
// Service Binding RPC rather than a local Service (GOV-01 D-022).
// TODO(SYS-14): replace mockReservationDetail with getReservation() and post
// cancelReservationByPlatform() — F-15-07, F-08-04.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockReservationDetail } from "$lib/mocks";
import type { ReservationDetail } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const reservation: ReservationDetail = mockReservationDetail;
---

<Layout title="予約の詳細 — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col gap-6 p-6" data-public-id={publicId}>
    <h1 class="text-2xl font-bold">{reservation.walkSlotTitle}</h1>

    <dl class="grid gap-1 text-sm">
      <div><dt class="inline text-muted-foreground">団体</dt> <dd class="inline">{reservation.organizationName}</dd></div>
      <div><dt class="inline text-muted-foreground">参加者</dt> <dd class="inline">{reservation.walkerName}</dd></div>
      <div><dt class="inline text-muted-foreground">人数</dt> <dd class="inline">{reservation.participantCount} 名</dd></div>
      <div><dt class="inline text-muted-foreground">状態</dt> <dd class="inline">{reservation.status}</dd></div>
      <div><dt class="inline text-muted-foreground">決済</dt> <dd class="inline">{reservation.payment?.status} / {reservation.payment?.amount} 円</dd></div>
    </dl>

    <form class="grid gap-3 text-sm" method="post" action={`/api/v1/reservations/${reservation.id}/cancel-by-platform`}>
      <label class="grid gap-1">
        <span>キャンセル理由</span>
        <textarea name="reason" rows="3" class="rounded border px-3 py-2"></textarea>
      </label>
      <button type="submit" class="w-fit rounded border border-red-300 px-3 py-2 text-red-700">運営判断でキャンセルする</button>
    </form>
  </main>
</Layout>

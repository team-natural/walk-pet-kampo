---
// SYS-13 — PRD-04 §3-3
// TODO(SYS-13): replace mockReservations with listReservations() — F-15-07.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { mockReservations } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { ReservationSummary } from "$lib/view-models/reservation";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const reservations: ReservationSummary[] = mockReservations;
---

<ConsoleLayout title="予約" user={session} breadcrumbs={[{ label: "予約" }]}>
  <PageHeader title="予約" description="全団体の予約を横断して確認し、必要に応じてキャンセルを代行します。" />

  <DataTable caption="予約の一覧" columns={["参加者", "お散歩", "団体", "人数", "状態", "予約日時"]} rowCount={reservations.length} emptyTitle="予約がありません" emptyDescription="参加者が予約するとここに表示されます。" emptyActionHref="/walks" emptyActionLabel="お散歩募集を見る">
    {
      reservations.map((reservation) => (
        <Table.Row>
          <Table.Cell>
            <a href={`/reservations/${reservation.id}`} class="rounded-sm font-medium underline-offset-4 hover:underline">
              {reservation.walkerName}
            </a>
          </Table.Cell>
          <Table.Cell>{reservation.walkSlotTitle}</Table.Cell>
          <Table.Cell class="text-muted-foreground">{reservation.organizationName}</Table.Cell>
          <Table.Cell class="tabular-nums">{reservation.participantCount} 名</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="reservation" value={reservation.status} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDateTime(reservation.createdAt)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

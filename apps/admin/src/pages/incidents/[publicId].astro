---
// SYS-20 — PRD-04 §3-3
// Read-only until P14, like SYS-10/12: `incidents.status` is written by apps/public's Service
// (DEV-09 §3-1) and the admin-side route that would reach it is GOV-02 TBD-58. The shelter can
// work its own report through in the meantime (ADM-19), which is what DEV-09 §2-10-2 allows.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import SeverityBadge from "$lib/components/severity-badge.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDateTime } from "$lib/format";
import { getSession } from "$lib/server/auth/session";
import { getIncidentByPublicId } from "$lib/server/services/incidents";
import { label } from "$lib/status";
import type { IncidentDetail } from "$lib/view-models/incident";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const incident: IncidentDetail = await getIncidentByPublicId(db, publicId!);
---

<ConsoleLayout title={`${incident.organizationName} の報告`} user={session} breadcrumbs={[{ label: "事故・トラブル", href: "/incidents" }, { label: incident.organizationName }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={incident.organizationName} description={`${label("incidentCategory", incident.category)} / ${formatDateTime(incident.occurredAt)}`}>
      <Fragment slot="meta">
        <p class="flex flex-wrap items-center gap-2 pt-1">
          <SeverityBadge severity={incident.severity} />
          <StatusBadge domain="incident" value={incident.status} />
        </p>
      </Fragment>
    </PageHeader>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="発生状況">
        <div><dt>発生日時</dt><dd class="tabular-nums">{formatDateTime(incident.occurredAt)}</dd></div>
        <div><dt>場所</dt><dd>{incident.location ?? "—"}</dd></div>
        <div><dt>種類</dt><dd>{label("incidentCategory", incident.category)}</dd></div>
        <div><dt>重大度</dt><dd>{incident.severity}</dd></div>
        <div><dt>報告者</dt><dd>{incident.reportedByName}</dd></div>
      </DetailCard>

      <DetailCard title="関係者">
        <div><dt>団体</dt><dd>{incident.organizationName}</dd></div>
        <div><dt>参加者</dt><dd>{incident.walkerName ?? "—"}</dd></div>
        <div><dt>保護犬</dt><dd>{incident.dogName ?? "—"}</dd></div>
        <div><dt>解決日時</dt><dd class="tabular-nums">{incident.resolvedAt ? formatDateTime(incident.resolvedAt) : "—"}</dd></div>
        <div><dt>最終更新</dt><dd class="tabular-nums">{formatDateTime(incident.updatedAt)}</dd></div>
      </DetailCard>
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="報告内容" list={false}>
        <p class="text-sm whitespace-pre-wrap">{incident.description}</p>
      </DetailCard>

      <DetailCard title="再発防止策" list={false}>
        <p class="text-sm whitespace-pre-wrap">{incident.preventionMeasures ?? "まだ記録されていません。"}</p>
      </DetailCard>
    </div>
  </div>
</ConsoleLayout>

---
// SYS-19 — PRD-04 §3-3
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import SeverityBadge from "$lib/components/severity-badge.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDateTime } from "$lib/format";
import { getSession } from "$lib/server/auth/session";
import { listIncidents } from "$lib/server/services/incidents";
import { label } from "$lib/status";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { items: incidents } = await listIncidents(db);
---

<ConsoleLayout title="事故・トラブル" user={session} breadcrumbs={[{ label: "事故・トラブル" }]}>
  <PageHeader title="事故・トラブル" description="団体から届いた報告を確認し、対応を記録します。P1 は当日中の一次対応が必要です。" />

  <DataTable caption="事故・トラブル報告の一覧" columns={["団体", "重大度", "種類", "報告者", "発生日時", "状態"]} rowCount={incidents.length} emptyTitle="報告はありません" emptyDescription="団体または参加者から報告が届くとここに表示されます。" emptyActionHref="/walks" emptyActionLabel="お散歩募集を見る">
    {
      incidents.map((incident) => (
        <Table.Row>
          <Table.Cell>
            <RowLink href={`/incidents/${incident.id}`}>{incident.organizationName}</RowLink>
          </Table.Cell>
          <Table.Cell>
            <SeverityBadge severity={incident.severity} />
          </Table.Cell>
          <Table.Cell>{label("incidentCategory", incident.category)}</Table.Cell>
          <Table.Cell class="text-muted-foreground">{incident.reportedByName}</Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDateTime(incident.occurredAt)}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="incident" value={incident.status} />
          </Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

---
// SYS-21 — PRD-04 §3-3
// The operator does not mediate adoption enquiries (GOV-02 TBD-32); this is a read-only view for
// oversight, which is why there is no action on the row.
// TODO(SYS-21): replace mockAdoptionInquiries with listAdoptionInquiries() — F-15-11.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockAdoptionInquiries } from "$lib/mocks";
import type { AdoptionInquirySummary } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const inquiries: AdoptionInquirySummary[] = mockAdoptionInquiries;
---

<Layout title="里親相談 — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">里親相談</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">保護犬</th>
          <th class="py-2">団体</th>
          <th class="py-2">参加者</th>
          <th class="py-2">状態</th>
        </tr>
      </thead>
      <tbody>
        {
          inquiries.map((inquiry) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/adoption-inquiries/${inquiry.id}`}>{inquiry.dogName}</a>
              </td>
              <td class="py-2">{inquiry.organizationName}</td>
              <td class="py-2">{inquiry.walkerName}</td>
              <td class="py-2">{inquiry.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

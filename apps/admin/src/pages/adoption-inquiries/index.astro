---
// SYS-21 — PRD-04 §3-3
// TODO(SYS-21): replace mockAdoptionInquiries with listAdoptionInquiries() — F-15-11.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import * as Table from "$lib/components/ui/table/index.js";
import { formatDate } from "$lib/format";
import { mockAdoptionInquiries } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { AdoptionInquirySummary } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const inquiries: AdoptionInquirySummary[] = mockAdoptionInquiries;
---

<ConsoleLayout title="里親相談" user={session} breadcrumbs={[{ label: "里親相談" }]}>
  <PageHeader title="里親相談" description="相談の状況を横断して確認します。譲渡の手続きそのものは各団体が行います。" />

  <DataTable caption="里親相談の一覧" columns={["保護犬", "相談者", "団体", "状態", "相談日"]} rowCount={inquiries.length} emptyTitle="相談はありません" emptyDescription="参加者が里親相談を送るとここに表示されます。" emptyActionHref="/dogs" emptyActionLabel="保護犬一覧を見る">
    {
      inquiries.map((inquiry) => (
        <Table.Row>
          <Table.Cell>
            <RowLink href={`/adoption-inquiries/${inquiry.id}`}>{inquiry.dogName}</RowLink>
          </Table.Cell>
          <Table.Cell>{inquiry.walkerName}</Table.Cell>
          <Table.Cell class="text-muted-foreground">{inquiry.organizationName}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="adoptionInquiry" value={inquiry.status} />
          </Table.Cell>
          <Table.Cell class="whitespace-nowrap text-muted-foreground tabular-nums">{formatDate(inquiry.createdAt)}</Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>

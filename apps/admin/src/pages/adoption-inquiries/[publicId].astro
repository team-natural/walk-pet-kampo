---
// SYS-22 — PRD-04 §3-3
// Read-only: the transfer itself follows each organization's own process (PRD-01 §1-0), so the
// platform records the conversation but never advances it.
// TODO(SYS-22): replace mockAdoptionInquiryDetail with getAdoptionInquiry() — F-15-11.
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DetailCard from "$lib/components/detail-card.astro";
import PageHeader from "$lib/components/page-header.astro";
import StatusBadge from "$lib/components/status-badge.svelte";
import { formatDateTime } from "$lib/format";
import { mockAdoptionInquiryDetail } from "$lib/mocks";
import { getSession } from "$lib/server/auth/session";
import type { AdoptionInquiryDetail } from "$lib/view-models/adoption-inquiry";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { publicId } = Astro.params;
const inquiry: AdoptionInquiryDetail = mockAdoptionInquiryDetail;
---

<ConsoleLayout title={`${inquiry.dogName} の里親相談`} user={session} breadcrumbs={[{ label: "里親相談", href: "/adoption-inquiries" }, { label: inquiry.dogName }]}>
  <div data-public-id={publicId} class="contents">
    <PageHeader title={inquiry.dogName} description={`${inquiry.walkerName} さんからの相談 / ${inquiry.organizationName}`}>
      <Fragment slot="meta">
        <p class="pt-1"><StatusBadge client:load domain="adoptionInquiry" value={inquiry.status} /></p>
      </Fragment>
    </PageHeader>

    <DetailCard title="相談の経過">
      <div><dt>相談日時</dt><dd class="tabular-nums">{formatDateTime(inquiry.createdAt)}</dd></div>
      <div><dt>団体からの連絡</dt><dd class="tabular-nums">{inquiry.organizationContactedAt ? formatDateTime(inquiry.organizationContactedAt) : "—"}</dd></div>
      <div><dt>終了日時</dt><dd class="tabular-nums">{inquiry.closedAt ? formatDateTime(inquiry.closedAt) : "—"}</dd></div>
      <div><dt>最終更新</dt><dd class="tabular-nums">{formatDateTime(inquiry.updatedAt)}</dd></div>
    </DetailCard>

    <div class="grid items-start gap-6 xl:grid-cols-2">
      <DetailCard title="相談内容" list={false}>
        <p class="text-sm whitespace-pre-wrap">{inquiry.motivation ?? "—"}</p>
      </DetailCard>

      <DetailCard title="飼育環境" list={false}>
        <p class="text-sm whitespace-pre-wrap">{inquiry.livingEnvironment ?? "—"}</p>
      </DetailCard>
    </div>

    <p class="text-sm text-muted-foreground">この画面は横断確認のための参照専用です。相談への返信と譲渡手続きは団体ページから行われます。</p>
  </div>
</ConsoleLayout>

---
// SYS-09 — PRD-04 §3-3
// TODO(SYS-09): replace mockDogs with listDogs() — F-15-05.
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSession } from "$lib/server/auth/session";
import { mockDogs } from "$lib/mocks";
import type { DogSummary } from "$lib/view-models/dog";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const dogs: DogSummary[] = mockDogs;
---

<Layout title="保護犬 — Admin console">
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col gap-6 p-6">
    <h1 class="text-2xl font-bold">保護犬</h1>

    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b">
          <th class="py-2">名前</th>
          <th class="py-2">団体</th>
          <th class="py-2">譲渡状況</th>
          <th class="py-2">公開</th>
        </tr>
      </thead>
      <tbody>
        {
          dogs.map((dog) => (
            <tr class="border-b">
              <td class="py-2">
                <a href={`/dogs/${dog.id}`}>{dog.name}</a>
              </td>
              <td class="py-2">{dog.organizationName}</td>
              <td class="py-2">{dog.adoptionStatus}</td>
              <td class="py-2">{dog.isPublished ? "公開" : "非公開"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>
</Layout>

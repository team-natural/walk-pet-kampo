---
// SYS-09 — PRD-04 §3-3
import { env } from "cloudflare:workers";
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import DataTable from "$lib/components/data-table.astro";
import PageHeader from "$lib/components/page-header.astro";
import RowLink from "$lib/components/row-link.svelte";
import StatusBadge from "$lib/components/status-badge.svelte";
import { Badge } from "$lib/components/ui/badge/index.js";
import * as Table from "$lib/components/ui/table/index.js";
import { getSession } from "$lib/server/auth/session";
import { listDogs } from "$lib/server/services/dogs";
import { label } from "$lib/status";
import { createDb } from "@app/schema/client";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const { items: dogs } = await listDogs(db);
---

<ConsoleLayout title="保護犬" user={session} breadcrumbs={[{ label: "保護犬" }]}>
  <PageHeader title="保護犬" description="全団体の保護犬を横断して確認します。登録・編集は団体側で行います。" />

  <DataTable caption="保護犬の一覧" columns={["名前", "団体", "犬種", "大きさ", "里親募集", "公開"]} rowCount={dogs.length} emptyTitle="登録された保護犬がいません" emptyDescription="団体が保護犬を登録するとここに表示されます。" emptyActionHref="/organizations" emptyActionLabel="保護団体一覧を見る">
    {
      dogs.map((dog) => (
        <Table.Row>
          <Table.Cell>
            <RowLink href={`/dogs/${dog.id}`}>{dog.name}</RowLink>
          </Table.Cell>
          <Table.Cell class="text-muted-foreground">{dog.organizationName}</Table.Cell>
          <Table.Cell>{dog.breed ?? "—"}</Table.Cell>
          <Table.Cell>{dog.size ? label("dogSize", dog.size) : "—"}</Table.Cell>
          <Table.Cell>
            <StatusBadge domain="dog" value={dog.adoptionStatus} />
          </Table.Cell>
          <Table.Cell>
            <Badge variant={dog.isPublished ? "secondary" : "outline"}>{dog.isPublished ? "公開中" : "非公開"}</Badge>
          </Table.Cell>
        </Table.Row>
      ))
    }
  </DataTable>
</ConsoleLayout>
